{
  "id": "com.example.cpp-lsp",
  "name": "C/C++ Language Server (clangd)",
  "version": "2.1.0",
  "apiVersion": 2,
  "publisher": "example",
  "description": "Bindet clangd für C/C++ ein. Das Paket clang installiert die App nach Bestätigung (Einstellungen → Plugins).",
  "permissions": [
    "shell"
  ],
  "entryPointClass": "com.example.codeforgeplugin.cpplsp.CppLspPlugin",
  "contributes": {
    "lspServers": [
      {
        "id": "clangd",
        "label": "clangd (C/C++)",
        "languages": [
          "c",
          "cpp"
        ],
        "command": [
          "clangd",
          "--background-index"
        ]
      }
    ],
    "requires": [
      {
        "manager": "pkg",
        "name": "clang",
        "check": "clangd"
      }
    ]
  }
}
