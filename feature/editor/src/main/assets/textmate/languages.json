{
  "_comment": "Manifest fuer GrammarRegistry.loadGrammars(); sora liest den Schluessel 'languages'. Pfade relativ zum Asset-Root.",
  "languages": [
    {
      "name": "Kotlin",
      "scopeName": "source.kotlin",
      "grammar": "textmate/grammars/kotlin.tmLanguage.json",
      "languageConfiguration": "textmate/languages/kotlin-language-configuration.json"
    },
    {
      "name": "Java",
      "scopeName": "source.java",
      "grammar": "textmate/grammars/java.tmLanguage.json",
      "languageConfiguration": "textmate/languages/java-language-configuration.json"
    },
    {
      "name": "XML",
      "scopeName": "text.xml",
      "grammar": "textmate/grammars/xml.tmLanguage.json",
      "languageConfiguration": "textmate/languages/xml-language-configuration.json"
    },
    {
      "name": "JSON",
      "scopeName": "source.json",
      "grammar": "textmate/grammars/json.tmLanguage.json",
      "languageConfiguration": "textmate/languages/json-language-configuration.json"
    }
  ]
}
