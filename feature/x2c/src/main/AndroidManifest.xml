<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <!-- Task 52.11: hält lange Läufe (Migration, Build, Rückgängig) am Leben und zeigt sie mit Abbrechen-Aktion. -->
        <service
            android:name="com.codeforge.feature.x2c.run.X2cForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="XML to Compose migration run" />
        </service>
    </application>

</manifest>
