<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
            Sandbox für Code-Plugins mit "sandbox": true. isolatedProcess: eigener Prozess mit eigener, zufälliger UID,
            ohne Berechtigungen, ohne Zugriff auf Dateien der App und ohne Netz. Der Plugin-Code kommt als Bytes.
        -->
        <service
            android:name="com.codeforge.libs.plugin_sandbox.PluginSandboxService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":plugin_sandbox" />
    </application>
</manifest>
