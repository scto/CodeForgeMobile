#!@TERMUX_PREFIX@/bin/bash
# codeforge-env — Einrichtung und Verwaltung der Android-Entwicklungsumgebung unter Termux.
#
# Wird als Termux-Paket im Bootstrap ausgeliefert (Quelle: packages/codeforge-env/ im
# terminal-packages-codeforge-Fork). Fehlt es dort, kopiert die App diese Datei beim
# Onboarding/Start nach $PREFIX/bin (ScriptInstaller). Die Platzhalter @…@ ersetzt entweder
# der Paket-Build oder die App.
#
# Aufruf:  codeforge-env [--machine] <befehl> [argumente]
#   list                         alle bekannten Komponenten mit Installationsstatus
#   install <id>                 z. B. jdk;21  ndk;r29  cmake;3.22.1  build-tools;37.0.0  platform-tools;37.0.0  platforms;android-36
#   uninstall <id>
#   setup [--jdk 17|21] [--sdk 37.0.0] [--platform 36] [--ndk r29] [--cmake 3.22.1] [--no-ndk] [--no-cmake]
#   env                          schreibt/zeigt die Umgebungsdatei (ANDROID_HOME, JAVA_HOME …)
#   doctor                       prüft die Umgebung
#
# --machine: maschinenlesbare Zeilen "CFSDK|TYP|…" (für den SDK-Manager der App):
#   CFSDK|ITEM|id|version|installiert(0/1)|pfad
#   CFSDK|PROGRESS|prozent|nachricht
#   CFSDK|OK|id
#   CFSDK|ERR|nachricht
#
# Quellen (ohne eigenes Manifest-Repo; gleiches Vorgehen wie scto/termux-android-setup):
#   - JDK, CMake und Ninja kommen als Termux-Pakete aus dem CodeForge-APT-Repo.
#   - cmdline-tools (sdkmanager, reines Java) kommen von Google (URL + SHA-256 unten als Standard).
#   - platforms;android-N und die Java-Teile der build-tools holt Googles sdkmanager.
#   - Native aarch64-Binaries (aapt2, aidl, zipalign, adb …) und das NDK stammen aus den
#     GitHub-Releases HomuHomu833/android-sdk-custom bzw. android-ndk-custom (Asset *-aarch64-linux-android.*).
#     Googles eigene Binaries sind x86 und laufen auf Android nicht. Das sind Drittanbieter-Builds.
#   - CMake: aarch64-Builds aus HomuHomu833/cmake-custom (mehrere Versionen, z. B. 3.22.1 als AGP-Standard);
#     alternativ das Termux-Paket (cmake;termux), per Symlink als $SDK_ROOT/cmake/<version> registriert.
#   - Die Versionslisten (build-tools, platform-tools, NDK, CMake) werden bei jedem Aufruf aus den
#     GitHub-Releases gebildet (nur Releases mit Asset *-aarch64-linux-android.*), 6 Stunden zwischengespeichert.
#     Ist GitHub nicht erreichbar, gilt eine feste Rückfallliste.
#   - GitHub-API ohne Token ist auf 60 Anfragen/Stunde begrenzt: bei Fehlern GITHUB_TOKEN setzen.
# Optional zusätzlich ein Manifest ($CODEFORGE_SDK_REPO/manifest.txt), Zeilenformat:
#   id|version|kind|source|sha256|dest|extra
#   kind=archive     source=URL (relativ zum Repo, wenn ohne "://"), dest relativ zu $SDK_ROOT,
#                    extra z. B. "strip=1"
#   kind=sdkmanager  source=Paketpfad für Googles sdkmanager (z. B. platforms;android-35)
#   kind=pkg         source=Termux-Paketname (wird per pkg installiert)

set -u

MACHINE=0
if [ "${1:-}" = "--machine" ]; then MACHINE=1; shift; fi

PREFIX="${PREFIX:-@TERMUX_PREFIX@}"
HOME="${HOME:-@TERMUX_HOME@}"
# SDK-Root: CODEFORGE_SDK_ROOT > ANDROID_SDK_ROOT aus $PREFIX/etc/codeforge-environment.properties
# (optionale Override-Datei) > $PREFIX/opt/android-sdk.
# Muss mit TermuxDevEnvironment.getSdkRoot() (App) übereinstimmen.
ENV_PROPS="$PREFIX/etc/codeforge-environment.properties"
props_sdk_root() {
  [ -f "$ENV_PROPS" ] || return 0
  sed -n 's/^ANDROID_SDK_ROOT=//p' "$ENV_PROPS" | head -n1 | tr -d '"'"'" \
    | sed -e "s|\${HOME}|$HOME|g" -e "s|\$HOME|$HOME|g" -e "s|\${PREFIX}|$PREFIX|g" -e "s|\$PREFIX|$PREFIX|g" \
          -e "s|\${SYSROOT}|$PREFIX|g" -e "s|\$SYSROOT|$PREFIX|g"
}
SDK_ROOT="${CODEFORGE_SDK_ROOT:-$(props_sdk_root)}"
SDK_ROOT="${SDK_ROOT:-$PREFIX/opt/android-sdk}"
CONF="$PREFIX/etc/codeforge/sdk.conf"
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"
REPO_URL="${CODEFORGE_SDK_REPO:-@CODEFORGE_SDK_REPO@}"
MANIFEST_URL="${CODEFORGE_SDK_MANIFEST:-$REPO_URL/manifest.txt}"
TMP="${TMPDIR:-$PREFIX/tmp}"
ENV_FILE="$PREFIX/etc/profile.d/codeforge-android.sh"
JVM_DIR="$PREFIX/lib/jvm"
mkdir -p "$TMP" "$SDK_ROOT" 2>/dev/null

# Standard: Googles Command-line Tools (reines Java, läuft mit dem Termux-JDK). Überschreibbar über sdk.conf
# (CMDLINE_TOOLS_URL / CMDLINE_TOOLS_SHA256) oder CODEFORGE_CMDLINE_TOOLS_URL / _SHA256.
# Bei einem Versionswechsel URL UND Prüfsumme gemeinsam ändern (Prüfsumme steht auf developer.android.com/studio).
CMDLINE_TOOLS_URL="${CODEFORGE_CMDLINE_TOOLS_URL:-${CMDLINE_TOOLS_URL:-https://dl.google.com/android/repository/commandlinetools-linux-15859902_latest.zip}}"
CMDLINE_TOOLS_SHA256="${CODEFORGE_CMDLINE_TOOLS_SHA256:-${CMDLINE_TOOLS_SHA256:-4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583}}"

GH_VARIANT="${ASSET_VARIANT:-aarch64-linux-android}"
SDK_CUSTOM_REPO="${SDK_REPO:-HomuHomu833/android-sdk-custom}"
NDK_CUSTOM_REPO="${NDK_REPO:-HomuHomu833/android-ndk-custom}"

CMAKE_CUSTOM_REPO="${CMAKE_REPO:-HomuHomu833/cmake-custom}"

DEFAULT_MANIFEST='jdk;17|17|pkg|openjdk-17|||
jdk;21|21|pkg|openjdk-21|||
cmake;termux|termux|cmake|cmake|||'
if [ -n "$CMDLINE_TOOLS_URL" ]; then
  DEFAULT_MANIFEST="$DEFAULT_MANIFEST"$'\n'"cmdline-tools;latest|latest|archive|$CMDLINE_TOOLS_URL|$CMDLINE_TOOLS_SHA256|cmdline-tools/latest|strip=1"
  DEFAULT_MANIFEST="$DEFAULT_MANIFEST"$'\n''platforms;android-35|35|sdkmanager|platforms;android-35|||'
  DEFAULT_MANIFEST="$DEFAULT_MANIFEST"$'\n''platforms;android-36|36|sdkmanager|platforms;android-36|||'
fi

# Rückfall, wenn die GitHub-API nicht erreichbar ist
FALLBACK_SDK="build-tools;37.0.0|37.0.0|ghsdk|$SDK_CUSTOM_REPO|||
platform-tools;37.0.0|37.0.0|ghpt|$SDK_CUSTOM_REPO|||"
FALLBACK_NDK="ndk;r29|r29|ghndk|$NDK_CUSTOM_REPO|||
ndk;r27d|r27d|ghndk|$NDK_CUSTOM_REPO|||"
FALLBACK_CMAKE="cmake;3.22.1|3.22.1|ghcmake|$CMAKE_CUSTOM_REPO|||"

# ---------- Ausgabe ----------
clean() { printf '%s' "$*" | tr '|\n\r' '   '; }
say()   { [ "$MACHINE" = 1 ] || printf '%s\n' "$*"; }
progress() { # prozent nachricht
  if [ "$MACHINE" = 1 ]; then printf 'CFSDK|PROGRESS|%s|%s\n' "$1" "$(clean "$2")"; else printf '[%3s%%] %s\n' "$1" "$2"; fi
}
ok()  { if [ "$MACHINE" = 1 ]; then printf 'CFSDK|OK|%s\n' "$1"; else printf 'OK: %s\n' "$1"; fi; }
err() { if [ "$MACHINE" = 1 ]; then printf 'CFSDK|ERR|%s\n' "$(clean "$*")"; else printf 'FEHLER: %s\n' "$*" >&2; fi; }
die() { err "$*"; exit 1; }

# ---------- Manifest ----------
# MANIFEST_CACHE wird einmal pro Aufruf auf oberster Ebene gebildet (build_manifest, siehe unten) –
# manifest() läuft oft in Subshells, dort ginge ein dort gesetzter Cache verloren.
MANIFEST_CACHE=""
manifest() { printf '%s\n' "$MANIFEST_CACHE"; }

# entry_field <id> <feldnummer> — das letzte Vorkommen gewinnt (Remote überschreibt Default)
entry_field() { manifest | awk -F'|' -v id="$1" -v n="$2" '$1==id{v=$n} END{print v}'; }
entry_exists() { manifest | awk -F'|' -v id="$1" '$1==id{f=1} END{exit f?0:1}'; }

jdk_home() { printf '%s/java-%s-openjdk' "$JVM_DIR" "$1"; }

# Pfad der installierten Komponente (leer = nicht installiert)
installed_path() { # id
  local id=$1 kind ver dest src
  kind=$(entry_field "$id" 3); ver=$(entry_field "$id" 2); src=$(entry_field "$id" 4); dest=$(entry_field "$id" 6)
  case "$kind" in
    pkg)
      case "$id" in
        jdk\;*) [ -x "$(jdk_home "$ver")/bin/java" ] && printf '%s' "$(jdk_home "$ver")" ;;
      esac ;;
    cmake)
      local cmk="$SDK_ROOT/cmake/.cf-termux" cmv
      if [ -f "$cmk" ]; then cmv=$(cat "$cmk"); [ -e "$SDK_ROOT/cmake/$cmv/bin/cmake" ] && printf '%s' "$SDK_ROOT/cmake/$cmv"; fi ;;
    ghcmake)
      [ -x "$SDK_ROOT/cmake/$ver/bin/cmake" ] && printf '%s' "$SDK_ROOT/cmake/$ver" ;;
    ghsdk)
      [ -x "$SDK_ROOT/build-tools/$ver/aapt2" ] && printf '%s' "$SDK_ROOT/build-tools/$ver" ;;
    ghpt)
      [ -x "$SDK_ROOT/platform-tools/adb" ] && printf '%s' "$SDK_ROOT/platform-tools" ;;
    ghndk)
      local mk="$SDK_ROOT/ndk/.cf-$ver" rev
      if [ -f "$mk" ]; then rev=$(cat "$mk"); [ -d "$SDK_ROOT/ndk/$rev" ] && printf '%s' "$SDK_ROOT/ndk/$rev"; fi ;;
    archive)
      [ -n "$dest" ] && [ -d "$SDK_ROOT/$dest" ] && printf '%s' "$SDK_ROOT/$dest" ;;
    sdkmanager)
      local p="$SDK_ROOT/${src//;//}"; [ -d "$p" ] && printf '%s' "$p" ;;
  esac
  return 0
}

# ---------- Hilfen ----------
need_tools() {
  local missing=() t
  for t in curl tar unzip sha256sum; do command -v "$t" >/dev/null 2>&1 || missing+=("$t"); done
  command -v xz >/dev/null 2>&1 || missing+=(xz-utils)
  command -v jq >/dev/null 2>&1 || missing+=(jq)
  command -v 7z >/dev/null 2>&1 || missing+=(p7zip)
  if [ ${#missing[@]} -gt 0 ]; then
    progress 1 "Installiere Werkzeuge: ${missing[*]}"
    local pkgs=() m
    for m in "${missing[@]}"; do case "$m" in sha256sum) pkgs+=(coreutils) ;; *) pkgs+=("$m") ;; esac; done
    pkg install -y "${pkgs[@]}" >/dev/null 2>&1 || die "Werkzeuge konnten nicht installiert werden: ${pkgs[*]}"
  fi
}

download() { # url ziel basis-prozent spanne
  local url=$1 dest=$2 base=$3 span=$4 total size pid pct
  total=$(curl -sIL "$url" 2>/dev/null | tr -d '\r' | awk 'tolower($1)=="content-length:"{v=$2} END{print v+0}')
  curl -fsSL -o "$dest" "$url" 2>"$TMP/.cfsdk-curl-err" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    size=$(stat -c %s "$dest" 2>/dev/null || echo 0)
    if [ "${total:-0}" -gt 0 ]; then pct=$(( base + size * span / total )); [ "$pct" -gt $(( base + span )) ] && pct=$(( base + span )); progress "$pct" "Lade herunter …"; fi
    sleep 1
  done
  wait "$pid" || { err "Download fehlgeschlagen: $url ($(head -c 200 "$TMP/.cfsdk-curl-err" 2>/dev/null))"; return 1; }
}

extract() { # archiv ziel strip
  local file=$1 dest=$2 strip=$3
  rm -rf "$dest.tmp"; mkdir -p "$dest.tmp"
  case "$file" in
    *.zip) unzip -q "$file" -d "$dest.tmp" || return 1
           if [ "$strip" -gt 0 ]; then
             local d; d=$(find "$dest.tmp" -mindepth 1 -maxdepth 1 | head -n1)
             if [ -n "$d" ] && [ -d "$d" ]; then mv "$d" "$dest.tmp.inner" && rm -rf "$dest.tmp" && mv "$dest.tmp.inner" "$dest.tmp"; fi
           fi ;;
    *.7z)  7z x -y -o"$dest.tmp" "$file" >/dev/null || return 1 ;;
    *) tar -xf "$file" -C "$dest.tmp" --strip-components="$strip" || return 1 ;;
  esac
  rm -rf "$dest"; mkdir -p "$(dirname "$dest")"; mv "$dest.tmp" "$dest"
}

# ---------- GitHub-Releases (HomuHomu833/android-*-custom) ----------
gh_api() {
  curl -fsSL -m 25 -H 'Accept: application/vnd.github+json' \
       ${GITHUB_TOKEN:+-H "Authorization: Bearer $GITHUB_TOKEN"} "$1"
}

# gh_find_asset <repo> <version> → GH_ASSET, GH_URL, GH_SHA (leer, wenn GitHub keine Prüfsumme liefert)
gh_find_asset() {
  local repo=$1 want=$2 json row digest
  json=$(gh_api "https://api.github.com/repos/$repo/releases?per_page=100") || { err "GitHub-API nicht erreichbar (Rate-Limit? GITHUB_TOKEN setzen)"; return 1; }
  row=$(printf '%s' "$json" | jq -r --arg v "$GH_VARIANT" --arg w "$want" '
    [ .[] | . as $r
      | ($r.assets[] | select(.name | test("-" + $v + "\\.(tar\\.xz|tar\\.gz|zip|7z)$"))) as $a
      | { n: (if ($r.name // "") != "" then $r.name else $r.tag_name end), t: $r.tag_name,
          a: $a.name, u: $a.browser_download_url, d: ($a.digest // "") } ]
    | map(select(.n == $w or .t == $w or (.a | contains("-" + $w + "-")))) | .[0] // empty
    | [.a, .u, .d] | @tsv') || { err "Antwort der GitHub-API nicht lesbar"; return 1; }
  [ -n "$row" ] || { err "Kein Release '$want' mit Asset *-$GH_VARIANT in $repo gefunden"; return 1; }
  IFS=$'\t' read -r GH_ASSET GH_URL digest <<<"$row"
  GH_SHA=${digest#sha256:}; [ "$GH_SHA" = "$digest" ] && GH_SHA=""
  return 0
}

# Releases eines Repos als JSON, 6 Stunden zwischengespeichert (schont das API-Limit von 60/Stunde)
gh_releases_json() {
  local repo=$1 f="$TMP/.cfsdk-gh-${1//\//_}.json" json
  if [ -s "$f" ] && [ -n "$(find "$f" -mmin -360 2>/dev/null)" ]; then cat "$f"; return 0; fi
  json=$(gh_api "https://api.github.com/repos/$repo/releases?per_page=100" 2>/dev/null) || { [ -s "$f" ] && cat "$f"; return 0; }
  printf '%s' "$json" | jq -e 'type == "array"' >/dev/null 2>&1 || { [ -s "$f" ] && cat "$f"; return 0; }
  printf '%s' "$json" > "$f"; printf '%s' "$json"
}

# gh_dynamic <repo> <idpräfix> <kind> [<idpräfix2> <kind2> …]: Manifestzeilen für jedes Release mit passendem Asset.
# Name = Release-Titel (sonst Tag), z. B. ndk;r28c, cmake;3.22.1, build-tools;37.0.0. Neueste zuerst (Reihenfolge der API).
gh_dynamic() {
  local repo=$1; shift
  command -v jq >/dev/null 2>&1 || return 0
  gh_releases_json "$repo" | jq -r --arg v "$GH_VARIANT" --arg repo "$repo" '
    .[]?
    | select(any(.assets[]?; .name | test("-" + $v + "\\.(tar\\.xz|tar\\.gz|zip|7z)$")))
    | (if (.name // "") != "" then .name else .tag_name end) as $n
    | select($n | test("^[A-Za-z0-9._-]+$"))
    | $ARGS.positional as $p
    | range(0; $p | length; 2) as $i
    | "\($p[$i]);\($n)|\($n)|\($p[$i + 1])|\($repo)|||"' --args "$@" 2>/dev/null
}

build_manifest() {
  local m="$DEFAULT_MANIFEST" remote="" dyn
  command -v jq >/dev/null 2>&1 || pkg install -y jq >/dev/null 2>&1
  dyn=$(gh_dynamic "$SDK_CUSTOM_REPO" build-tools ghsdk platform-tools ghpt); [ -n "$dyn" ] || dyn=$FALLBACK_SDK
  m="$m"$'\n'"$dyn"
  dyn=$(gh_dynamic "$NDK_CUSTOM_REPO" ndk ghndk); [ -n "$dyn" ] || dyn=$FALLBACK_NDK
  m="$m"$'\n'"$dyn"
  dyn=$(gh_dynamic "$CMAKE_CUSTOM_REPO" cmake ghcmake); [ -n "$dyn" ] || dyn=$FALLBACK_CMAKE
  m="$m"$'\n'"$dyn"
  case "$MANIFEST_URL" in
    *@*) ;; # nicht ersetzter Platzhalter
    *) remote=$(curl -fsSL --max-time 20 "$MANIFEST_URL" 2>/dev/null | tr -d '\r' | grep -v '^[[:space:]]*#' | grep '|' || true) ;;
  esac
  [ -n "$remote" ] && m="$m"$'\n'"$remote"
  printf '%s\n' "$m"
}

# gh_fetch_extract <zielordner>: lädt GH_URL, prüft ggf. die Prüfsumme, entpackt nach <zielordner>; setzt GH_ROOT
gh_fetch_extract() {
  local out=$1 file="$TMP/cfsdk-$GH_ASSET" got d
  progress 8 "Lade $GH_ASSET …"
  download "$GH_URL" "$file" 8 62 || { rm -f "$file"; return 1; }
  if [ -n "$GH_SHA" ]; then
    progress 72 "Prüfe Prüfsumme …"
    got=$(sha256sum "$file" | awk '{print $1}')
    [ "$got" = "$GH_SHA" ] || { rm -f "$file"; err "Prüfsumme stimmt nicht für $GH_ASSET (erwartet $GH_SHA, erhalten $got)"; return 1; }
  else
    say "Warnung: GitHub liefert keine Prüfsumme für $GH_ASSET – Download ist nicht verifiziert"
  fi
  progress 75 "Entpacke (kann dauern) …"
  extract "$file" "$out" 0 || { rm -f "$file"; err "Entpacken fehlgeschlagen: $GH_ASSET"; return 1; }
  rm -f "$file"
  GH_ROOT=$out
  d=$(find "$out" -mindepth 1 -maxdepth 1 | head -n 2)
  [ "$(printf '%s\n' "$d" | grep -c .)" = 1 ] && [ -d "$d" ] && GH_ROOT=$d
  return 0
}

# Termux-CMake für AGP registrieren: $SDK_ROOT/cmake/<version>/bin/{cmake,ninja}
link_cmake() {
  command -v cmake >/dev/null 2>&1 || return 1
  local v d
  v=$(cmake --version | head -n1 | awk '{print $3}'); [ -n "$v" ] || return 1
  [ -e "$SDK_ROOT/cmake/$v/bin/cmake" ] && [ ! -L "$SDK_ROOT/cmake/$v/bin/cmake" ] && return 1  # echte Installation gleicher Version
  d="$SDK_ROOT/cmake/$v/bin"
  mkdir -p "$d"
  printf '%s' "$v" > "$SDK_ROOT/cmake/.cf-termux"
  ln -sf "$(command -v cmake)" "$d/cmake"
  command -v ninja >/dev/null 2>&1 && ln -sf "$(command -v ninja)" "$d/ninja"
  printf 'Pkg.Revision = %s\nPkg.Path = cmake;%s\n' "$v" "$v" > "$SDK_ROOT/cmake/$v/source.properties"
}

# ---------- install / uninstall ----------
do_install() { # id
  local id=$1 kind ver src sha dest extra strip=0 url file
  entry_exists "$id" || die "Unbekannte Komponente: $id"
  kind=$(entry_field "$id" 3); ver=$(entry_field "$id" 2); src=$(entry_field "$id" 4)
  sha=$(entry_field "$id" 5); dest=$(entry_field "$id" 6); extra=$(entry_field "$id" 7)
  case "$extra" in *strip=*) strip=${extra##*strip=}; strip=${strip%%[!0-9]*} ;; esac
  : "${strip:=0}"

  case "$kind" in
    pkg)
      progress 5 "Installiere Paket $src …"
      pkg install -y "$src" >/dev/null 2>&1 || die "pkg install $src fehlgeschlagen"
      ;;
    archive)
      need_tools
      case "$src" in *://*) url=$src ;; *) url="$REPO_URL/$src" ;; esac
      file="$TMP/cfsdk-$(printf '%s' "$id" | tr -c 'A-Za-z0-9.' '_')-${src##*/}"
      progress 2 "Starte Download $id"
      download "$url" "$file" 2 78 || { rm -f "$file"; exit 1; }
      if [ -n "$sha" ]; then
        progress 82 "Prüfe Prüfsumme …"
        local got; got=$(sha256sum "$file" | awk '{print $1}')
        [ "$got" = "$sha" ] || { rm -f "$file"; die "Prüfsumme stimmt nicht für $id (erwartet $sha, erhalten $got)"; }
      elif [ "$id" = 'cmdline-tools;latest' ]; then
        rm -f "$file"; die "Keine SHA-256 für cmdline-tools gesetzt (CMDLINE_TOOLS_SHA256 in $CONF)"
      else
        say "Warnung: keine Prüfsumme im Manifest für $id"
      fi
      progress 88 "Entpacke …"
      extract "$file" "$SDK_ROOT/$dest" "$strip" || { rm -f "$file"; die "Entpacken fehlgeschlagen für $id"; }
      rm -f "$file"
      [ -d "$SDK_ROOT/$dest/bin" ] && chmod -R u+x "$SDK_ROOT/$dest/bin" 2>/dev/null
      ;;
    sdkmanager)
      local sm="$SDK_ROOT/cmdline-tools/latest/bin/sdkmanager"
      if [ ! -x "$sm" ]; then
        entry_exists 'cmdline-tools;latest' || die "cmdline-tools nicht konfiguriert: CMDLINE_TOOLS_URL und CMDLINE_TOOLS_SHA256 in $CONF setzen"
        say "cmdline-tools fehlen — installiere sie zuerst"; ( do_install 'cmdline-tools;latest' ) || exit 1
      fi
      progress 10 "sdkmanager installiert $src …"
      export JAVA_HOME="${JAVA_HOME:-$(first_jdk)}"
      yes 2>/dev/null | "$sm" --sdk_root="$SDK_ROOT" "$src" >/dev/null 2>&1 \
        || die "sdkmanager konnte $src nicht installieren"
      ;;
    cmake)
      progress 5 "Installiere cmake und ninja …"
      pkg install -y cmake ninja >/dev/null 2>&1 || die "pkg install cmake ninja fehlgeschlagen"
      link_cmake || die "CMake konnte nicht für Gradle registriert werden"
      ;;
    ghndk)
      need_tools
      progress 3 "Suche NDK $ver bei GitHub …"
      gh_find_asset "$src" "$ver" || exit 1
      say "NDK-Download ist groß (mehrere GB) und braucht beim Entpacken zusätzlich Platz."
      local nx="$TMP/cfsdk-ndk-extract" rev nd
      gh_fetch_extract "$nx" || { rm -rf "$nx"; exit 1; }
      [ -f "$GH_ROOT/source.properties" ] || { rm -rf "$nx"; die "source.properties im NDK nicht gefunden"; }
      rev=$(grep -E '^Pkg.Revision' "$GH_ROOT/source.properties" | cut -d= -f2 | tr -d ' \r')
      [ -n "$rev" ] || { rm -rf "$nx"; die "Pkg.Revision im NDK nicht lesbar"; }
      progress 90 "Installiere NDK $rev …"
      mkdir -p "$SDK_ROOT/ndk"; rm -rf "$SDK_ROOT/ndk/$rev"
      mv "$GH_ROOT" "$SDK_ROOT/ndk/$rev" || { rm -rf "$nx"; die "NDK konnte nicht verschoben werden"; }
      rm -rf "$nx"
      nd="$SDK_ROOT/ndk/$rev"
      printf '%s' "$rev" > "$SDK_ROOT/ndk/.cf-$ver"
      ln -sfn "$nd" "$SDK_ROOT/ndk-bundle"
      find "$nd/toolchains" -path '*/bin/*' -type f -exec chmod +x {} + 2>/dev/null
      local clang; clang=$(find "$nd/toolchains/llvm/prebuilt" -path '*/bin/clang' 2>/dev/null | head -n1)
      if [ -n "$clang" ] && "$clang" --version >/dev/null 2>&1; then say "NDK-clang: $("$clang" --version | head -n1)"
      else say "Warnung: NDK-clang startet nicht – Asset-Variante prüfen (ASSET_VARIANT=$GH_VARIANT)"; fi
      ;;
    ghcmake)
      need_tools
      local cx="$TMP/cfsdk-cmake-extract" cmbin croot cdir
      progress 3 "Suche CMake $ver bei GitHub …"
      gh_find_asset "$src" "$ver" || exit 1
      gh_fetch_extract "$cx" || { rm -rf "$cx"; exit 1; }
      cmbin=$(find "$GH_ROOT" -type f -path '*/bin/cmake' | head -n1)
      [ -n "$cmbin" ] || { rm -rf "$cx"; die "bin/cmake im CMake-Archiv nicht gefunden"; }
      croot=$(dirname "$(dirname "$cmbin")")
      cdir="$SDK_ROOT/cmake/$ver"
      progress 90 "Installiere CMake $ver …"
      mkdir -p "$SDK_ROOT/cmake"; rm -rf "$cdir"
      mv "$croot" "$cdir" || { rm -rf "$cx"; die "CMake konnte nicht verschoben werden"; }
      rm -rf "$cx"
      chmod +x "$cdir"/bin/* 2>/dev/null
      if [ ! -x "$cdir/bin/ninja" ]; then
        command -v ninja >/dev/null 2>&1 || pkg install -y ninja >/dev/null 2>&1
        if command -v ninja >/dev/null 2>&1; then ln -sf "$(command -v ninja)" "$cdir/bin/ninja"
        else say "Warnung: ninja fehlt (pkg install ninja)"; fi
      fi
      printf 'Pkg.Revision = %s\nPkg.Path = cmake;%s\n' "$ver" "$ver" > "$cdir/source.properties"
      "$cdir/bin/cmake" --version >/dev/null 2>&1 || say "Warnung: cmake startet nicht – Asset-Variante prüfen (ASSET_VARIANT=$GH_VARIANT)"
      ;;
    ghpt)
      need_tools
      local px="$TMP/cfsdk-pt-extract" padb
      progress 6 "Suche platform-tools $ver bei GitHub …"
      gh_find_asset "$src" "$ver" || exit 1
      gh_fetch_extract "$px" || { rm -rf "$px"; exit 1; }
      padb=$(find "$GH_ROOT" -type f -name adb | head -n1)
      [ -n "$padb" ] || { rm -rf "$px"; die "adb im SDK-Archiv nicht gefunden"; }
      mkdir -p "$SDK_ROOT/platform-tools"; cp -a "$(dirname "$padb")"/. "$SDK_ROOT/platform-tools"/
      find "$SDK_ROOT/platform-tools" -maxdepth 1 -type f ! -name '*.properties' -exec chmod +x {} + 2>/dev/null
      rm -rf "$px"
      ;;
    ghsdk)
      need_tools
      local bt="$SDK_ROOT/build-tools/$ver" sm="$SDK_ROOT/cmdline-tools/latest/bin/sdkmanager" sx="$TMP/cfsdk-sdk-extract" aapt2 adb
      # a) Java-Teile und Metadaten der offiziellen build-tools (sdkmanager), falls verfügbar
      if [ ! -x "$sm" ] && entry_exists 'cmdline-tools;latest'; then ( do_install 'cmdline-tools;latest' ) || say "Warnung: cmdline-tools konnten nicht installiert werden"; fi
      if [ -x "$sm" ]; then
        progress 4 "sdkmanager installiert build-tools;$ver …"
        export JAVA_HOME="${JAVA_HOME:-$(first_jdk)}"
        yes 2>/dev/null | "$sm" --sdk_root="$SDK_ROOT" "build-tools;$ver" >/dev/null 2>&1 \
          || say "Warnung: build-tools;$ver bei Google nicht verfügbar – nur aarch64-Binaries werden genutzt"
      else
        say "Warnung: kein sdkmanager – build-tools enthalten nur die aarch64-Binaries"
      fi
      # b) native aarch64-Binaries einspielen
      progress 6 "Suche SDK-Binaries $ver bei GitHub …"
      gh_find_asset "$src" "$ver" || exit 1
      gh_fetch_extract "$sx" || { rm -rf "$sx"; exit 1; }
      aapt2=$(find "$GH_ROOT" -type f -name aapt2 | head -n1)
      adb=$(find "$GH_ROOT" -type f -name adb | head -n1)
      [ -n "$aapt2" ] || { rm -rf "$sx"; die "aapt2 im SDK-Archiv nicht gefunden"; }
      mkdir -p "$bt"; cp -a "$(dirname "$aapt2")"/. "$bt"/
      find "$bt" -maxdepth 2 -type f ! -name '*.jar' ! -name '*.xml' ! -name '*.properties' -exec chmod +x {} + 2>/dev/null
      if [ -n "$adb" ]; then
        mkdir -p "$SDK_ROOT/platform-tools"; cp -a "$(dirname "$adb")"/. "$SDK_ROOT/platform-tools"/
        find "$SDK_ROOT/platform-tools" -maxdepth 1 -type f ! -name '*.properties' -exec chmod +x {} + 2>/dev/null
      fi
      rm -rf "$sx"
      [ -f "$bt/source.properties" ] || printf 'Pkg.Desc = Android SDK Build-Tools %s (aarch64)\nPkg.Revision = %s\n' "$ver" "$ver" > "$bt/source.properties"
      "$bt/aapt2" version >/dev/null 2>&1 || say "Warnung: aapt2 startet nicht – Asset-Variante prüfen (ASSET_VARIANT=$GH_VARIANT)"
      ;;
    *) die "Unbekannter Typ '$kind' im Manifest für $id" ;;
  esac
  progress 100 "Fertig"
  ok "$id"
}

do_uninstall() { # id
  local id=$1 kind src p
  entry_exists "$id" || die "Unbekannte Komponente: $id"
  kind=$(entry_field "$id" 3); src=$(entry_field "$id" 4)
  p=$(installed_path "$id")
  [ -n "$p" ] || { ok "$id"; return 0; }
  case "$kind" in
    pkg) pkg uninstall -y "$src" >/dev/null 2>&1 || die "Deinstallation von $src fehlgeschlagen" ;;
    archive) rm -rf "$p" ;;
    sdkmanager) rm -rf "$p" ;;
    cmake) rm -rf "$p" "$SDK_ROOT/cmake/.cf-termux" ;;   # Symlinks; die Termux-Pakete cmake/ninja bleiben installiert
    ghcmake) rm -rf "$p" ;;
    ghsdk) rm -rf "$p" ;;   # nur build-tools/<version>
    ghpt) rm -rf "$p" ;;
    ghndk) rm -rf "$p" "$SDK_ROOT/ndk/.cf-$(entry_field "$id" 2)"
           [ -e "$SDK_ROOT/ndk-bundle" ] || rm -f "$SDK_ROOT/ndk-bundle" ;;
  esac
  ok "$id"
}

first_jdk() { local d; for d in "$JVM_DIR"/java-*-openjdk; do [ -x "$d/bin/java" ] && { printf '%s' "$d"; return; }; done; }

# ---------- list ----------
do_list() {
  local line id ver kind p inst
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    id=${line%%|*}; ver=$(entry_field "$id" 2)
    p=$(installed_path "$id"); inst=0; [ -n "$p" ] && inst=1
    if [ "$MACHINE" = 1 ]; then printf 'CFSDK|ITEM|%s|%s|%s|%s\n' "$id" "$ver" "$inst" "$p"
    else printf '%-28s %-12s %s\n' "$id" "$ver" "$([ "$inst" = 1 ] && echo "installiert ($p)" || echo '-')"; fi
  done < <(manifest | awk -F'|' '!seen[$1]++{print $1}')
}

# ---------- env ----------
write_env() { # jdkVer ndkId cmakeId
  local jdkver=$1 ndk=${2:-} cmake=${3:-} jh p
  jh=$(jdk_home "$jdkver"); [ -x "$jh/bin/java" ] || jh=$(first_jdk)
  mkdir -p "$(dirname "$ENV_FILE")"
  {
    echo "# erzeugt von codeforge-env — nicht von Hand ändern"
    echo "export ANDROID_HOME=\"$SDK_ROOT\""
    echo "export ANDROID_SDK_ROOT=\"$SDK_ROOT\""
    [ -n "$jh" ] && echo "export JAVA_HOME=\"$jh\""
    if [ -n "$ndk" ]; then p=$(installed_path "$ndk"); [ -n "$p" ] && echo "export ANDROID_NDK_HOME=\"$p\""; fi
    local path_add="$SDK_ROOT/cmdline-tools/latest/bin:$SDK_ROOT/platform-tools"
    if [ -n "$cmake" ]; then p=$(installed_path "$cmake"); [ -n "$p" ] && path_add="$p/bin:$path_add"; fi
    echo "export PATH=\"$path_add:\$PATH\""
  } > "$ENV_FILE"
  # Gradle braucht ein aapt2, das auf dem Gerät läuft: das aarch64-aapt2 aus den eigenen build-tools
  # (build-tools), sonst ein Termux-Paket 'aapt2'. Das x86-aapt2 von Google/Maven läuft hier nicht.
  local bt aapt2
  bt=$(ls -d "$SDK_ROOT"/build-tools/* 2>/dev/null | sort -V | tail -n1)
  aapt2="$bt/aapt2"
  [ -n "$bt" ] && [ -x "$aapt2" ] || aapt2="$PREFIX/bin/aapt2"
  if [ -x "$aapt2" ]; then
    mkdir -p "$HOME/.gradle"
    local gp="$HOME/.gradle/gradle.properties"
    grep -v '^android.aapt2FromMavenOverride=' "$gp" 2>/dev/null > "$gp.new" || true
    echo "android.aapt2FromMavenOverride=$aapt2" >> "$gp.new"; mv "$gp.new" "$gp"
  fi
}

do_setup() {
  local jdk=17 ndk=r29 cmake=3.22.1 sdk=37.0.0 platform=36 want_ndk=1 want_cmake=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --jdk) jdk=$2; shift 2 ;; --ndk) ndk=$2; shift 2 ;; --cmake) cmake=$2; shift 2 ;;
      --sdk) sdk=$2; shift 2 ;; --platform) platform=$2; shift 2 ;;
      --no-ndk) want_ndk=0; shift ;; --no-cmake) want_cmake=0; shift ;;
      *) die "Unbekannte Option: $1" ;;
    esac
  done
  # NDK: '27d' wird zu 'r27d'; gibt es genau diese Version nicht (z. B. 'r29d'), gilt das Release gleicher Hauptversion ('r29').
  case "$ndk" in [0-9]*) ndk="r$ndk" ;; esac
  if [ "$want_ndk" = 1 ] && ! entry_exists "ndk;$ndk"; then
    local nbase nalt
    nbase=$(printf '%s' "$ndk" | sed -E 's/^(r[0-9]+).*/\1/')
    nalt=$(manifest | awk -F'|' -v b="ndk;$nbase" '$1 ~ ("^" b "[a-z]?$") {print $1; exit}')
    if [ -n "$nalt" ]; then say "NDK $ndk nicht vorhanden – verwende ${nalt#ndk;}"; ndk=${nalt#ndk;}; fi
  fi
  # CMake: gewünschte Version, sonst das Termux-Paket
  if [ "$want_cmake" = 1 ] && ! entry_exists "cmake;$cmake"; then
    say "CMake $cmake nicht verfügbar – verwende das Termux-Paket"; cmake=termux
  fi
  local steps=("jdk;$jdk" 'cmdline-tools;latest' "build-tools;$sdk" "platform-tools;$sdk" "platforms;android-$platform")
  [ "$want_ndk" = 1 ] && steps+=("ndk;$ndk")
  [ "$want_cmake" = 1 ] && steps+=("cmake;$cmake")
  local total=${#steps[@]} i=0 id
  for id in "${steps[@]}"; do
    i=$((i+1))
    if ! entry_exists "$id"; then say "Überspringe $id (nicht im Manifest)"; continue; fi
    if [ -n "$(installed_path "$id")" ]; then say "$id bereits installiert"; continue; fi
    say "== ($i/$total) $id =="
    ( do_install "$id" ) || die "Einrichtung abgebrochen bei $id"
  done
  write_env "$jdk" "$( [ "$want_ndk" = 1 ] && echo "ndk;$ndk")" "$( [ "$want_cmake" = 1 ] && echo "cmake;$cmake")"
  progress 100 "Umgebung eingerichtet"
  say "Neue Shell öffnen oder 'source $ENV_FILE' ausführen."
  ok setup
}

do_doctor() {
  local rc=0 t
  for t in bash curl tar unzip java jq; do command -v "$t" >/dev/null 2>&1 && say "ok   $t" || { say "FEHLT $t"; rc=1; }; done
  [ -d "$SDK_ROOT" ] && say "ok   SDK_ROOT=$SDK_ROOT" || { say "FEHLT SDK_ROOT"; rc=1; }
  [ -f "$ENV_FILE" ] && say "ok   $ENV_FILE" || { say "FEHLT $ENV_FILE (codeforge-env setup)"; rc=1; }
  case "$MANIFEST_URL" in *@*) say "WARN  CODEFORGE_SDK_REPO ist nicht konfiguriert ($CONF)"; rc=1 ;; esac
  exit $rc
}

cmd=${1:-help}; [ $# -gt 0 ] && shift
case "$cmd" in list|install|uninstall|setup) MANIFEST_CACHE=$(build_manifest) ;; esac
case "$cmd" in
  list) do_list ;;
  install) [ $# -ge 1 ] || die "install braucht eine ID"; do_install "$1" ;;
  uninstall) [ $# -ge 1 ] || die "uninstall braucht eine ID"; do_uninstall "$1" ;;
  setup) do_setup "$@" ;;
  env) [ -f "$ENV_FILE" ] && cat "$ENV_FILE" || die "Noch nicht eingerichtet (codeforge-env setup)" ;;
  doctor) do_doctor ;;
  help|-h|--help) sed -n '2,/^set -u/p' "$0" | sed 's/^# \{0,1\}//' | head -n 40 ;;
  *) die "Unbekannter Befehl: $cmd (codeforge-env help)" ;;
esac
