#!@TERMUX_PREFIX@/bin/bash
# codeforge-env — Einrichtung und Verwaltung der Android-Entwicklungsumgebung unter Termux.
#
# Wird als Termux-Paket im Bootstrap ausgeliefert (Quelle: packages/codeforge-env/ im
# terminal-packages-codeforge-Fork). Fehlt es dort, kopiert die App diese Datei beim
# Onboarding/Start nach $PREFIX/bin (ScriptInstaller). Die Platzhalter @…@ ersetzt entweder
# der Paket-Build oder die App.
#
# Aufruf:  codeforge-env [--machine] <befehl> [argumente]
#   list                         alle bekannten Komponenten mit Installationsstatus
#   install <id|paket>           z. B. jdk;21  ndk;r29  cmake;3.22.1  build-tools;37.0.0  platform-tools;37.0.0  platforms;android-36  gradle
#   uninstall <id>
#   pkg <paket> [paket …]        installiert Repo-Pakete (große Pakete > 30 MiB über large-packages.txt, sonst per pkg)
#   setup [--jdk 17|21] [--sdk 37.0.0] [--platform 36] [--ndk r29] [--cmake 4.1.2]   (Standard: JDK 21, CMake 4.1.2)
#         [--no-ndk] [--no-cmake] [--no-gradle] [--no-kotlin] [--no-extras] [--minimal]
#                                Basis-Setup für Android-Entwicklung (ohne Optionen alles):
#                                JDK, cmdline-tools, build-tools, platform-tools, Plattform, NDK, CMake/Ninja,
#                                Gradle, Kotlin-Compiler (kotlinc, für die Compose-Vorschau) und git/zip/unzip.
#                                --minimal: nur JDK + SDK (wie früher), Gradle/Kotlin/Extras mit --gradle/--kotlin/--extras zuschalten.
#   repair [--yes]               repariert defekte Bootstrap-Pakete
#   env                          schreibt/zeigt die Umgebungsdatei (ANDROID_HOME, JAVA_HOME …)
#   doctor                       prüft die Umgebung
#
# --machine: maschinenlesbare Zeilen "CFSDK|TYP|…" (für den SDK-Manager der App):
#   CFSDK|ITEM|id|version|installiert(0/1)|pfad
#   CFSDK|PROGRESS|prozent|nachricht
#   CFSDK|OK|id
#   CFSDK|ERR|nachricht
#
# Quellen:
#   - JDK, CMake und Ninja kommen als Termux-Pakete aus dem CodeForge-APT-Repo.
#   - cmdline-tools (sdkmanager, reines Java) kommen aus dem Mirror: Release cmdline-tools-19.0 von $TOOLS_REPO
#     (SHA-256 fest hinterlegt). Nicht erreichbar -> Fallback: temporär aus dem Archiv android-sdk-37.0.0 entpackt.
#     Kein Download von dl.google.com mehr (es sei denn, CODEFORGE_CMDLINE_TOOLS_URL setzt ihn ausdrücklich).
#   - platforms;android-N und die Java-Teile der build-tools holt der sdkmanager (Repository von Google).
#   - Native Android-Binaries (aapt2, aidl, zipalign, adb …), NDK und CMake kommen aus dem eigenen
#     Mirror $TOOLS_REPO (Standard scto/codeforge-tools, siehe dessen README). Googles eigene Binaries sind
#     x86 und laufen auf Android nicht. Tags im Mirror:
#       android-sdk-<v>          build-tools;<v> und platform-tools;<v>   (HomuHomu833/android-sdk-custom, ab 36.0.2)
#       android-ndk-<name>       ndk;<name>                               (HomuHomu833/android-ndk-custom)
#       cmake-<v>                cmake;<v>                                (HomuHomu833/cmake-custom)
#       androidide-tools-v<v>    build-tools;<v>, platform-tools;<v>      (AndroidIDEOfficial/androidide-tools, 33.x/34.x, statisch)
#       lzhiyong-sdk-tools-<v>   build-tools;<v> (nur Binaries, Überlagerung der Google-build-tools; Lzhiyong/android-sdk-tools)
#     Gibt der Mirror für eine Komponente nichts her (nicht erreichbar, noch leer), gelten die Upstream-Repos
#     HomuHomu833/* direkt (SDK_REPO/NDK_REPO/CMAKE_REPO), danach eine feste Rückfallliste.
#     Beta-/RC-Releases (Name oder Tag mit "beta"/"rc") werden nie angeboten.
#   - Alternativ das Termux-CMake (cmake;termux), per Symlink als $SDK_ROOT/cmake/<version> registriert.
#   - Die Versionslisten werden bei jedem Aufruf aus den GitHub-Releases gebildet, 6 Stunden zwischengespeichert.
#   - GitHub-API ohne Token ist auf 60 Anfragen/Stunde begrenzt: bei Fehlern GITHUB_TOKEN setzen.
#   - Prüfsumme: GitHubs "digest" des Assets, sonst die <asset>.sha256 aus dem Mirror-Release; fehlt beides, Warnung.
#   - Überschreibbar über sdk.conf oder Umgebung: TOOLS_REPO (leer = Mirror aus), SDK_REPO, NDK_REPO, CMAKE_REPO,
#     ASSET_VARIANT (Standard nach uname -m: aarch64 -> aarch64-linux-android, 32-bit-ARM -> armv7a-linux-androideabi),
#     AIDE_VARIANT (aarch64 oder arm, sonst aus uname -m).
# Optional zusätzlich ein Manifest ($CODEFORGE_SDK_REPO/manifest.txt), Zeilenformat:
#   id|version|kind|source|sha256|dest|extra
#   kind=archive     source=URL (relativ zum Repo, wenn ohne "://"), dest relativ zu $SDK_ROOT,
#                    extra z. B. "strip=1"
#   kind=sdkmanager  source=Paketpfad für Googles sdkmanager (z. B. platforms;android-35)
#   kind=pkg         source=Termux-Paketname (wird per pkg installiert)

set -u

MACHINE=0
if [ "${1:-}" = "--machine" ]; then MACHINE=1; shift; fi

PREFIX="${PREFIX:-@TERMUX_PREFIX@}"
HOME="${HOME:-@TERMUX_HOME@}"
# SDK-Root: CODEFORGE_SDK_ROOT > ANDROID_SDK_ROOT aus $PREFIX/etc/codeforge-environment.properties
# (optionale Override-Datei) > $PREFIX/opt/android-sdk.
# Muss mit TermuxDevEnvironment.getSdkRoot() (App) übereinstimmen.
ENV_PROPS="$PREFIX/etc/codeforge-environment.properties"
props_sdk_root() {
  [ -f "$ENV_PROPS" ] || return 0
  sed -n 's/^ANDROID_SDK_ROOT=//p' "$ENV_PROPS" | head -n1 | tr -d '"'"'" \
    | sed -e "s|\${HOME}|$HOME|g" -e "s|\$HOME|$HOME|g" -e "s|\${PREFIX}|$PREFIX|g" -e "s|\$PREFIX|$PREFIX|g" \
          -e "s|\${SYSROOT}|$PREFIX|g" -e "s|\$SYSROOT|$PREFIX|g"
}
SDK_ROOT="${CODEFORGE_SDK_ROOT:-$(props_sdk_root)}"
SDK_ROOT="${SDK_ROOT:-$PREFIX/opt/android-sdk}"
CONF="$PREFIX/etc/codeforge/sdk.conf"
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"
REPO_URL="${CODEFORGE_SDK_REPO:-@CODEFORGE_SDK_REPO@}"
MANIFEST_URL="${CODEFORGE_SDK_MANIFEST:-$REPO_URL/manifest.txt}"
TMP="${TMPDIR:-$PREFIX/tmp}"
mkdir -p "$TMP" 2>/dev/null || true   # $PREFIX/tmp fehlt in frischen Bootstraps (JVM/Gradle brauchen es)
ENV_FILE="$PREFIX/etc/profile.d/codeforge-android.sh"
JVM_DIR="$PREFIX/lib/jvm"
LOG_DIR="$HOME/.codeforge/logs"
LOG_FILE="$LOG_DIR/setup-$(date +%Y-%m-%d).log"
CURRENT_SETUP_RETRY_CMD=""
PKG_UPDATED=0
mkdir -p "$TMP" "$SDK_ROOT" "$LOG_DIR" 2>/dev/null
APT_OPTS=(-o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::ftp::Timeout=30)

# cmdline-tools (reines Java, läuft mit dem Termux-JDK). Standard: Release cmdline-tools-$CMDLINE_REV des Mirrors
# (https://github.com/scto/codeforge-tools/releases/tag/cmdline-tools-19.0, Asset cmdline-tools-19.0.tar.xz).
# Überschreibbar über sdk.conf bzw. Umgebung:
#   CMDLINE_REV (Standard 19.0) · CMDLINE_TOOLS_URL / CMDLINE_TOOLS_SHA256 (eigene Quelle, z. B. Googles ZIP)
#   Bei anderer Revision als 19.0 ohne CMDLINE_TOOLS_SHA256 wird die <asset>.sha256 des Releases verwendet.
CMDLINE_REV="${CODEFORGE_CMDLINE_REV:-${CMDLINE_REV:-19.0}}"
CMDLINE_SDK_VER="${CODEFORGE_CMDLINE_SDK_VER:-${CMDLINE_SDK_VER:-37.0.0}}"   # SDK-Archiv für den Fallback
CMDLINE_TOOLS_URL="${CODEFORGE_CMDLINE_TOOLS_URL:-${CMDLINE_TOOLS_URL-__mirror__}}"
CMDLINE_TOOLS_SHA256="${CODEFORGE_CMDLINE_TOOLS_SHA256:-${CMDLINE_TOOLS_SHA256:-}}"

# Architektur des Geräts -> Asset-Variante (HomuHomu833/Mirror: *-aarch64-linux-android bzw. *-armv7a-linux-androideabi,
# androidide-tools/Lzhiyong: aarch64 bzw. arm). 32-bit-Userland (armv7l/armv8l) bekommt die armv7a-Builds.
case "$(uname -m)" in
  aarch64|arm64)      GH_VARIANT_DEFAULT=aarch64-linux-android;     AIDE_VARIANT_DEFAULT=aarch64; CF_ARCH=aarch64 ;;
  armv7l|armv8l|arm*) GH_VARIANT_DEFAULT=armv7a-linux-androideabi;  AIDE_VARIANT_DEFAULT=arm;     CF_ARCH=arm ;;
  *)                  GH_VARIANT_DEFAULT=aarch64-linux-android;     AIDE_VARIANT_DEFAULT=aarch64; CF_ARCH=aarch64 ;;
esac
GH_VARIANT="${ASSET_VARIANT:-$GH_VARIANT_DEFAULT}"
# Eigener Mirror (Releases android-sdk-*, android-ndk-*, cmake-*, androidide-tools-v*, lzhiyong-sdk-tools-*)
TOOLS_REPO="${CODEFORGE_TOOLS_REPO:-${TOOLS_REPO-scto/codeforge-tools}}"
AIDE_VARIANT="${AIDE_VARIANT:-$AIDE_VARIANT_DEFAULT}"
# cmdline-tools-URL: Mirror-Release (Standard), eigene URL oder leer (= keine cmdline-tools/platforms im Manifest)
if [ "$CMDLINE_TOOLS_URL" = "__mirror__" ]; then
  if [ -n "$TOOLS_REPO" ]; then
    CMDLINE_TOOLS_URL="https://github.com/$TOOLS_REPO/releases/download/cmdline-tools-$CMDLINE_REV/cmdline-tools-$CMDLINE_REV.tar.xz"
    [ -n "$CMDLINE_TOOLS_SHA256" ] || [ "$CMDLINE_REV" != "19.0" ] || CMDLINE_TOOLS_SHA256=f9ab9233b8ced6f74fd682a8a3c68a52031bc761bc06425e8dc502adb93fca9e
  else
    CMDLINE_TOOLS_URL=""
  fi
fi
SDK_CUSTOM_REPO="${SDK_REPO:-HomuHomu833/android-sdk-custom}"
NDK_CUSTOM_REPO="${NDK_REPO:-HomuHomu833/android-ndk-custom}"

CMAKE_CUSTOM_REPO="${CMAKE_REPO:-HomuHomu833/cmake-custom}"

DEFAULT_MANIFEST='jdk;17|17|pkg|openjdk-17|||
jdk;21|21|pkg|openjdk-21|||
cmake;termux|termux|cmake|cmake|||'
if [ -n "$CMDLINE_TOOLS_URL" ]; then
  DEFAULT_MANIFEST="$DEFAULT_MANIFEST"$'\n'"cmdline-tools;latest|$CMDLINE_REV|archive|$CMDLINE_TOOLS_URL|$CMDLINE_TOOLS_SHA256|cmdline-tools/latest|strip=1"
  DEFAULT_MANIFEST="$DEFAULT_MANIFEST"$'\n''platforms;android-35|35|sdkmanager|platforms;android-35|||'
  DEFAULT_MANIFEST="$DEFAULT_MANIFEST"$'\n''platforms;android-36|36|sdkmanager|platforms;android-36|||'
fi

# Rückfall, wenn die GitHub-API nicht erreichbar ist
FALLBACK_SDK="build-tools;37.0.0|37.0.0|ghsdk|$SDK_CUSTOM_REPO|||
platform-tools;37.0.0|37.0.0|ghpt|$SDK_CUSTOM_REPO|||"
FALLBACK_NDK="ndk;r29|r29|ghndk|$NDK_CUSTOM_REPO|||
ndk;r27d|r27d|ghndk|$NDK_CUSTOM_REPO|||"
FALLBACK_CMAKE="cmake;3.22.1|3.22.1|ghcmake|$CMAKE_CUSTOM_REPO|||"

# ---------- Ausgabe ----------
clean() { printf '%s' "$*" | tr '|\n\r' '   '; }
say()   { [ "$MACHINE" = 1 ] || printf '%s\n' "$*"; }
progress() { # prozent nachricht
  if [ "$MACHINE" = 1 ]; then printf 'CFSDK|PROGRESS|%s|%s\n' "$1" "$(clean "$2")"; else printf '[%3s%%] %s\n' "$1" "$2"; fi
}
ok()  { if [ "$MACHINE" = 1 ]; then printf 'CFSDK|OK|%s\n' "$1"; else printf 'OK: %s\n' "$1"; fi; }
err() { if [ "$MACHINE" = 1 ]; then printf 'CFSDK|ERR|%s\n' "$(clean "$*")"; else printf 'FEHLER: %s\n' "$*" >&2; fi; }
die() {
  err "$*"
  if [ -n "${CURRENT_SETUP_RETRY_CMD:-}" ]; then
    say "Logdatei: $LOG_FILE"
    say "Erneut versuchen: $CURRENT_SETUP_RETRY_CMD"
  fi
  exit 1
}

format_component_id() {
  case "$1" in
    jdk\;*)            printf 'JDK %s' "${1#jdk;}" ;;
    cmdline-tools\;*)  printf 'cmdline-tools (%s)' "${1#cmdline-tools;}" ;;
    build-tools\;*)    printf 'build-tools %s' "${1#build-tools;}" ;;
    platform-tools\;*) printf 'platform-tools %s' "${1#platform-tools;}" ;;
    platforms\;*)      printf 'Platform %s' "${1#platforms;}" ;;
    ndk\;*)            printf 'NDK %s' "${1#ndk;}" ;;
    cmake\;*)          printf 'CMake %s' "${1#cmake;}" ;;
    *)                 printf '%s' "${1//;/ }" ;;
  esac
}

# ---------- Manifest ----------
# MANIFEST_CACHE wird einmal pro Aufruf auf oberster Ebene gebildet (build_manifest, siehe unten) –
# manifest() läuft oft in Subshells, dort ginge ein dort gesetzter Cache verloren.
MANIFEST_CACHE=""
manifest() { printf '%s\n' "$MANIFEST_CACHE"; }

# entry_field <id> <feldnummer> — das letzte Vorkommen gewinnt (Remote überschreibt Default)
entry_field() { manifest | awk -F'|' -v id="$1" -v n="$2" '$1==id{v=$n} END{print v}'; }
entry_exists() { manifest | awk -F'|' -v id="$1" '$1==id{f=1} END{exit f?0:1}'; }

jdk_home() { printf '%s/java-%s-openjdk' "$JVM_DIR" "$1"; }

# Pfad der installierten Komponente (leer = nicht installiert)
installed_path() { # id
  local id=$1 kind ver dest src
  kind=$(entry_field "$id" 3); ver=$(entry_field "$id" 2); src=$(entry_field "$id" 4); dest=$(entry_field "$id" 6)
  case "$kind" in
    pkg)
      case "$id" in
        jdk\;*) [ -x "$(jdk_home "$ver")/bin/java" ] && printf '%s' "$(jdk_home "$ver")" ;;
        *) [ -n "$src" ] && command -v "$src" >/dev/null 2>&1 && command -v "$src" ;;
      esac ;;
    cmake)
      local cmk="$SDK_ROOT/cmake/.cf-termux" cmv
      if [ -f "$cmk" ]; then cmv=$(cat "$cmk"); [ -e "$SDK_ROOT/cmake/$cmv/bin/cmake" ] && printf '%s' "$SDK_ROOT/cmake/$cmv"; fi ;;
    ghcmake)
      [ -x "$SDK_ROOT/cmake/$ver/bin/cmake" ] && printf '%s' "$SDK_ROOT/cmake/$ver" ;;
    ghsdk|ghaidebt)
      [ -x "$SDK_ROOT/build-tools/$ver/aapt2" ] && printf '%s' "$SDK_ROOT/build-tools/$ver" ;;
    ghpt|ghaidept)
      # platform-tools gibt es nur einmal; die Marke sagt, welche Version installiert wurde
      [ -x "$SDK_ROOT/platform-tools/adb" ] && [ "$(cat "$SDK_ROOT/platform-tools/.cf-version" 2>/dev/null)" = "$ver" ] \
        && printf '%s' "$SDK_ROOT/platform-tools" ;;
    ghndk)
      local mk="$SDK_ROOT/ndk/.cf-$ver" rev
      if [ -f "$mk" ]; then rev=$(cat "$mk"); [ -d "$SDK_ROOT/ndk/$rev" ] && printf '%s' "$SDK_ROOT/ndk/$rev"; fi ;;
    archive)
      [ -n "$dest" ] && [ -d "$SDK_ROOT/$dest" ] && printf '%s' "$SDK_ROOT/$dest" ;;
    sdkmanager)
      local p="$SDK_ROOT/${src//;//}"; [ -d "$p" ] && printf '%s' "$p" ;;
  esac
  return 0
}

# ---------- Hilfen ----------
need_tools() {
  local missing=() t
  for t in curl tar unzip sha256sum; do command -v "$t" >/dev/null 2>&1 || missing+=("$t"); done
  command -v xz >/dev/null 2>&1 || missing+=(xz-utils)
  command -v jq >/dev/null 2>&1 || missing+=(jq)
  if [ ${#missing[@]} -gt 0 ]; then
    progress 1 "Installiere Werkzeuge: ${missing[*]}"
    local pkgs=() m
    for m in "${missing[@]}"; do case "$m" in sha256sum) pkgs+=(coreutils) ;; *) pkgs+=("$m") ;; esac; done
    pkg_install "${pkgs[@]}" || die "Werkzeuge konnten nicht installiert werden: ${pkgs[*]}"
  fi
}

download() { # url ziel basis-prozent spanne
  local url=$1 dest=$2 base=$3 span=$4 total size pid pct
  total=$(curl -sIL --max-time 15 "$url" 2>/dev/null | tr -d '\r' | awk 'tolower($1)=="content-length:"{v=$2} END{print v+0}')
  curl -fsSL --connect-timeout 30 --speed-limit 1024 --speed-time 120 -o "$dest" "$url" 2>"$TMP/.cfsdk-curl-err" &
  pid=$!
  local last_size=0 stall_sec=0
  while kill -0 "$pid" 2>/dev/null; do
    size=$(stat -c %s "$dest" 2>/dev/null || echo 0)
    if [ "$size" -eq "$last_size" ]; then
      stall_sec=$((stall_sec + 1))
      if [ "$stall_sec" -ge 120 ]; then
        kill -9 "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
        err "Download abgebrochen: Stall-Timeout (keine Daten empfangen seit 120s): $url"
        return 1
      fi
    else
      last_size=$size
      stall_sec=0
    fi
    if [ "${total:-0}" -gt 0 ]; then
      pct=$(( base + size * span / total ))
      [ "$pct" -gt $(( base + span )) ] && pct=$(( base + span ))
      local mb=$(( size / 1048576 )) total_mb=$(( total / 1048576 ))
      progress "$pct" "Lade herunter ($mb/$total_mb MB) …"
    else
      local mb=$(( size / 1048576 ))
      progress "$base" "Lade herunter ($mb MB) …"
    fi
    sleep 1
  done
  wait "$pid" || { err "Download fehlgeschlagen: $url ($(head -c 200 "$TMP/.cfsdk-curl-err" 2>/dev/null))"; return 1; }
}

# Große Pakete (> 30 MiB, z. B. gradle, openjdk-*, libllvm) liegen wegen des
# 100-MB-Dateilimits und des 1-GB-Seitenlimits von GitHub Pages nicht im APT-Pool, sondern als Asset am Release
# 'large-packages'. Das Verzeichnis '<apt-url>/large-packages.txt' enthält Zeilen:
#   name|version|arch|datei|sha256|bytes|url
# Benötigt: say, err, download, $TMP, $PREFIX.

apt_base_url() {
  local sl="$PREFIX/etc/apt/sources.list" url=""
  if [ -f "$sl" ]; then
    url=$(awk '!/^[[:space:]]*#/ && $1=="deb" {for(i=2;i<=NF;i++) if ($i ~ /^https?:\/\//) {print $i; exit}}' "$sl")
  fi
  if [ -z "$url" ] && [ -d "$PREFIX/etc/apt/sources.list.d" ]; then
    url=$(awk '!/^[[:space:]]*#/ && $1=="deb" {for(i=2;i<=NF;i++) if ($i ~ /^https?:\/\//) {print $i; exit}}' "$PREFIX/etc/apt/sources.list.d"/*.list 2>/dev/null | head -n1)
  fi
  printf '%s' "${url%/}"
}

install_repo_pkg() {
  local want="${1:-}" base arch man="$TMP/.cfsdk-large-packages.txt" row ver rarch asset sha bytes url deb got keyring
  [ -n "$want" ] || return 1
  base=$(apt_base_url)
  arch=$(dpkg --print-architecture 2>/dev/null || echo "${CF_ARCH:-aarch64}")
  row=""
  if [ -n "$base" ]; then
    if [ ! -s "$man" ]; then
      curl -fsSL --max-time 15 "$base/large-packages.txt" >"$man" 2>/dev/null || rm -f "$man"
      keyring="$PREFIX/share/termux-keyring/codeforge.gpg"
      if [ -s "$man" ] && [ -s "$keyring" ] && command -v gpgv >/dev/null 2>&1; then
        if curl -fsSL --max-time 15 "$base/large-packages.txt.asc" >"$man.asc" 2>/dev/null && [ -s "$man.asc" ]; then
          if ! gpgv --keyring "$keyring" "$man.asc" "$man" >/dev/null 2>&1; then
            err "GPG-Signatur von large-packages.txt ungültig!"
            rm -f "$man" "$man.asc"
            return 1
          fi
        fi
        rm -f "$man.asc"
      fi
    fi
    if [ -s "$man" ]; then
      row=$(awk -F'|' -v p="$want" -v a="$arch" '$1==p && ($3==a || $3=="all") {v=$0} END{print v}' "$man")
    fi
  fi

  if [ -z "$row" ]; then
    if [ -n "${PKG_INSTALL_OUT:-}" ]; then
      DEBIAN_FRONTEND=noninteractive pkg install "${APT_OPTS[@]}" -y "$want" >"$PKG_INSTALL_OUT" 2>&1
    else
      DEBIAN_FRONTEND=noninteractive pkg install "${APT_OPTS[@]}" -y "$want"
    fi
    return $?
  fi

  IFS='|' read -r _ ver rarch asset sha bytes url <<<"$row"
  case "$url" in
    https://github.com/*) ;;
    *)
      err "Ungültige Download-URL für großes Paket $want (nur https://github.com/ erlaubt): $url"
      return 1
      ;;
  esac
  printf '%s' "$sha" | grep -Eq '^[0-9a-f]{64}$' || {
    err "Ungültige SHA-256 im Manifest für $want: $sha"
    return 1
  }

  deb="$TMP/${asset##*/}"
  say "Lade großes Paket $want $ver ($rarch) von GitHub Release …"
  download "$url" "$deb" 10 75 || { rm -f "$deb"; return 1; }

  got=$(sha256sum "$deb" | cut -d' ' -f1)
  if [ "$got" != "$sha" ]; then
    err "Prüfsumme für $asset stimmt nicht (erwartet $sha, erhalten $got)"
    rm -f "$deb"
    return 1
  fi

  say "Installiere $asset …"
  if [ -n "${PKG_INSTALL_OUT:-}" ]; then
    if ! DEBIAN_FRONTEND=noninteractive apt install "${APT_OPTS[@]}" -y "$deb" >"$PKG_INSTALL_OUT" 2>&1; then
      rm -f "$deb"
      return 1
    fi
  elif ! DEBIAN_FRONTEND=noninteractive apt install "${APT_OPTS[@]}" -y "$deb"; then
    rm -f "$deb"
    return 1
  fi
  rm -f "$deb"
  return 0
}

apt_repo_url() {
  local url
  url=$(apt_base_url)
  printf '%s' "${url:-unbekannt ($PREFIX/etc/apt/sources.list)}"
}

pkg_update_once() {
  [ "$PKG_UPDATED" = 1 ] && return 0
  PKG_UPDATED=1
  mkdir -p "$LOG_DIR" 2>/dev/null
  local up_out="$TMP/.cfsdk-apt-update.out" rc=0
  {
    printf '\n=== [%s] apt-get update ===\n' "$(date '+%Y-%m-%d %H:%M:%S')"
  } >> "$LOG_FILE" 2>/dev/null
  if command -v apt-get >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get "${APT_OPTS[@]}" update -y >"$up_out" 2>&1 || rc=$?
  else
    pkg update "${APT_OPTS[@]}" -y >"$up_out" 2>&1 || rc=$?
  fi
  cat "$up_out" >> "$LOG_FILE" 2>/dev/null
  if [ "$rc" -ne 0 ] || grep -Eq '^(Err:|E:|W: Failed to fetch|.*NO_PUBKEY|.*404  Not Found|.*Could not resolve)' "$up_out" 2>/dev/null; then
    err "Paketlisten-Update (apt-get update) meldet Probleme (URL: $(apt_repo_url)):"
    if [ "$MACHINE" != 1 ]; then
      grep -E '(Err:|E:|Failed to fetch|NO_PUBKEY|404|Could not resolve|Clearsigned|signature)' "$up_out" >&2 || tail -n 15 "$up_out" >&2
    fi
  fi
  rm -f "$up_out"
  return 0
}

pkg_install() {
  [ $# -gt 0 ] || return 0
  pkg_update_once
  mkdir -p "$LOG_DIR" 2>/dev/null
  local out_file="$TMP/.cfsdk-pkg-install.out" rc=0 repo_url _pkg
  for _pkg in "$@"; do
    {
      printf '\n=== [%s] install_repo_pkg %s ===\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$_pkg"
    } >> "$LOG_FILE" 2>/dev/null
    : > "$out_file" 2>/dev/null || true
    rc=0
    PKG_INSTALL_OUT="$out_file" install_repo_pkg "$_pkg" || rc=$?
    [ -s "$out_file" ] && cat "$out_file" >> "$LOG_FILE" 2>/dev/null
    if [ "$rc" -ne 0 ]; then
      repo_url=$(apt_repo_url)
      if grep -q "Unable to locate package" "$out_file" 2>/dev/null; then
        err "Paket fehlt im APT-Repo (Etappe bauen) – URL: $repo_url (Paket: $_pkg)"
      else
        err "pkg install $_pkg fehlgeschlagen (Exit-Code $rc, Log: $LOG_FILE)"
      fi
      if [ "$MACHINE" != 1 ]; then
        if [ -s "$out_file" ]; then
          printf -- '--- Letzte 20 Zeilen aus %s ---\n' "$LOG_FILE" >&2
          tail -n 20 "$out_file" >&2
        fi
        if command -v apt-cache >/dev/null 2>&1; then
          printf -- '--- apt-cache policy %s ---\n' "$_pkg" >&2
          apt-cache policy "$_pkg" 2>&1 | tee -a "$LOG_FILE" >&2
        fi
        printf -- '-------------------------------\n' >&2
      else
        if command -v apt-cache >/dev/null 2>&1; then
          apt-cache policy "$_pkg" >> "$LOG_FILE" 2>&1 || true
        fi
      fi
      rm -f "$out_file"
      return "$rc"
    fi
    rm -f "$out_file"
  done
  return 0
}

extract() { # archiv ziel strip
  local file=$1 dest=$2 strip=$3
  rm -rf "$dest.tmp"; mkdir -p "$dest.tmp"
  case "$file" in
    *.zip) unzip -q "$file" -d "$dest.tmp" || return 1
           if [ "$strip" -gt 0 ]; then
             local d; d=$(find "$dest.tmp" -mindepth 1 -maxdepth 1 | head -n1)
             if [ -n "$d" ] && [ -d "$d" ]; then mv "$d" "$dest.tmp.inner" && rm -rf "$dest.tmp" && mv "$dest.tmp.inner" "$dest.tmp"; fi
           fi ;;
    *.7z)  command -v 7z >/dev/null 2>&1 || pkg_install p7zip
           7z x -y -o"$dest.tmp" "$file" >/dev/null || return 1 ;;
    *) tar -xf "$file" -C "$dest.tmp" --strip-components="$strip" || return 1 ;;
  esac
  rm -rf "$dest"; mkdir -p "$(dirname "$dest")"; mv "$dest.tmp" "$dest"
}

# ---------- GitHub-Releases (Mirror $TOOLS_REPO bzw. HomuHomu833/android-*-custom) ----------
gh_api() {
  curl -fsSL -m 25 -H 'Accept: application/vnd.github+json' \
       ${GITHUB_TOKEN:+-H "Authorization: Bearer $GITHUB_TOKEN"} "$1"
}

# Regex für das Asset einer Mirror-Quelle (leer = Standard: *-<GH_VARIANT>.<archiv>)
asset_re_for() { # tagprefix kind version
  local v=${3//./\\.}
  case "$1" in
    androidide-tools-v)
      case "$2" in
        ghaidebt) printf '^build-tools-%s-%s\\.tar\\.xz$' "$v" "$AIDE_VARIANT" ;;
        ghaidept) printf '^platform-tools-%s-%s\\.tar\\.xz$' "$v" "$AIDE_VARIANT" ;;
      esac ;;
    lzhiyong-sdk-tools-) printf '^android-sdk-tools-static-%s\\.zip$' "$AIDE_VARIANT" ;;
  esac
}
# Regex, mit der ein Release als installierbar erkannt wird (hat ein passendes Asset)
probe_re_for() { # tagprefix
  case "$1" in
    androidide-tools-v) printf -- '-%s\\.tar\\.xz$' "$AIDE_VARIANT" ;;
    lzhiyong-sdk-tools-) printf '^android-sdk-tools-static-%s\\.zip$' "$AIDE_VARIANT" ;;
    *) printf -- '-%s\\.(tar\\.xz|tar\\.gz|zip|7z)$' "$GH_VARIANT" ;;
  esac
}

# Beta-/RC-Releases werden nicht angeboten ("beta"/"rc" als eigenes Wort in Name oder Tag)
GH_SKIP_RE='(^|[^a-z])(beta|rc)([^a-z]|$)'

# gh_find_asset <repo> <version> [<tagprefix> [<asset-regex>]] → GH_ASSET, GH_URL, GH_SHA, GH_SHA_URL
# Mit tagprefix (Mirror) zählt nur ein Release mit passendem Tag; die Version ist dann der Tag ohne Präfix.
# GH_SHA bleibt leer, wenn GitHub keine Prüfsumme liefert; GH_SHA_URL zeigt dann auf <asset>.sha256 des Releases.
gh_find_asset() {
  local repo=$1 want=$2 tp=${3:-} are=${4:-} json row digest
  json=$(gh_releases_json "$repo") && [ -n "$json" ] || { err "GitHub-API nicht erreichbar (Rate-Limit? GITHUB_TOKEN setzen)"; return 1; }
  row=$(printf '%s' "$json" | jq -r --arg v "$GH_VARIANT" --arg w "$want" --arg tp "$tp" --arg are "$are" --arg skip "$GH_SKIP_RE" '
    ($are | if . == "" then "-" + $v + "\\.(tar\\.xz|tar\\.gz|zip|7z)$" else . end) as $re
    | [ .[] | select(($tp == "") or (.tag_name | startswith($tp))) | . as $r
      | ($r.assets[] | select(.name | test($re))) as $a
      | { n: (if $tp != "" then ($r.tag_name | ltrimstr($tp)) elif ($r.name // "") != "" then $r.name else $r.tag_name end),
          t: $r.tag_name, a: $a.name, u: $a.browser_download_url, d: ($a.digest // ""),
          s: ([ $r.assets[] | select(.name == ($a.name + ".sha256")) | .browser_download_url ][0] // "") } ]
    | map(select((.n | test($skip; "i") | not) and (.t | test($skip; "i") | not)))
    | map(select(.n == $w or .t == $w or ($tp == "" and (.a | contains("-" + $w + "-"))))) | .[0] // empty
    | [.a, .u, .d, .s] | join("|")') || { err "Antwort der GitHub-API nicht lesbar"; return 1; }
  [ -n "$row" ] || { err "Kein Release '$want' mit passendem Asset in $repo gefunden"; return 1; }
  IFS='|' read -r GH_ASSET GH_URL digest GH_SHA_URL <<<"$row"
  GH_SHA=${digest#sha256:}; [ "$GH_SHA" = "$digest" ] && GH_SHA=""
  return 0
}

# Releases eines Repos als JSON (bis zu 3 Seiten à 100), 6 Stunden zwischengespeichert (schont das API-Limit von 60/Stunde)
gh_releases_json() {
  local repo=$1 f="$TMP/.cfsdk-gh-${1//\//_}.json" json="[]" part page
  if [ -s "$f" ] && [ -n "$(find "$f" -mmin -360 2>/dev/null)" ]; then cat "$f"; return 0; fi
  for page in 1 2 3; do
    part=$(gh_api "https://api.github.com/repos/$repo/releases?per_page=100&page=$page" 2>/dev/null) || { json=""; break; }
    printf '%s' "$part" | jq -e 'type == "array"' >/dev/null 2>&1 || { json=""; break; }
    json=$(printf '%s\n%s' "$json" "$part" | jq -cs 'add')
    [ "$(printf '%s' "$part" | jq 'length')" -lt 100 ] && break
  done
  [ -n "$json" ] || { [ -s "$f" ] && cat "$f"; return 0; }
  printf '%s' "$json" > "$f"; printf '%s' "$json"
}

# gh_dynamic <repo> <idpräfix> <kind> [<idpräfix2> <kind2> …]: Manifestzeilen für jedes Release des Upstream-Repos mit passendem Asset.
# Name = Release-Titel (sonst Tag), z. B. ndk;r28c, cmake;3.22.1, build-tools;37.0.0. Neueste zuerst (Reihenfolge der API).
gh_dynamic() {
  local repo=$1; shift
  command -v jq >/dev/null 2>&1 || return 0
  gh_releases_json "$repo" | jq -r --arg v "$GH_VARIANT" --arg repo "$repo" --arg skip "$GH_SKIP_RE" '
    .[]?
    | select(any(.assets[]?; .name | test("-" + $v + "\\.(tar\\.xz|tar\\.gz|zip|7z)$")))
    | (if (.name // "") != "" then .name else .tag_name end) as $n
    | select($n | test("^[A-Za-z0-9._-]+$"))
    | select(($n | test($skip; "i") | not) and (.tag_name | test($skip; "i") | not))
    | $ARGS.positional as $p
    | range(0; $p | length; 2) as $i
    | "\($p[$i]);\($n)|\($n)|\($p[$i + 1])|\($repo)|||"' --args "$@" 2>/dev/null
}

# mirror_dynamic <tagprefix> <idpräfix> <kind> [<idpräfix2> <kind2> …]: Manifestzeilen aus dem Mirror $TOOLS_REPO.
# Version = Tag ohne Präfix (android-ndk-r29 → r29). Das Präfix steht im Feld "extra" (tagprefix=…).
mirror_dynamic() {
  local tp=$1; shift
  [ -n "$TOOLS_REPO" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  gh_releases_json "$TOOLS_REPO" | jq -r --arg tp "$tp" --arg repo "$TOOLS_REPO" --arg re "$(probe_re_for "$tp")" --arg skip "$GH_SKIP_RE" '
    .[]?
    | select(.tag_name | startswith($tp))
    | select(any(.assets[]?; .name | test($re)))
    | (.tag_name | ltrimstr($tp)) as $n
    | select($n | test("^[A-Za-z0-9._-]+$"))
    | select(($n | test($skip; "i") | not))
    | $ARGS.positional as $p
    | range(0; $p | length; 2) as $i
    | "\($p[$i]);\($n)|\($n)|\($p[$i + 1])|\($repo)|||tagprefix=\($tp)"' --args "$@" 2>/dev/null
}

# Pro Komponente: Mirror, sonst Upstream, sonst feste Rückfallliste
build_manifest() {
  local m="$DEFAULT_MANIFEST" remote="" dyn d
  # build-tools / platform-tools: HomuHomu833-SDK (ab 36.0.2), danach androidide-tools (33.x/34.x), danach Lzhiyong (35.x).
  # Doppelte IDs: die erste Quelle gewinnt (androidide-tools ist vollständiger als Lzhiyong).
  dyn=$(mirror_dynamic android-sdk- build-tools ghsdk platform-tools ghpt)
  [ -n "$dyn" ] || dyn=$(gh_dynamic "$SDK_CUSTOM_REPO" build-tools ghsdk platform-tools ghpt)
  [ -n "$dyn" ] || dyn=$FALLBACK_SDK
  d=$(mirror_dynamic androidide-tools-v build-tools ghaidebt platform-tools ghaidept); [ -n "$d" ] && dyn="$dyn"$'\n'"$d"
  d=$(mirror_dynamic lzhiyong-sdk-tools- build-tools ghsdk); [ -n "$d" ] && dyn="$dyn"$'\n'"$d"
  m="$m"$'\n'"$(printf '%s\n' "$dyn" | awk -F'|' 'NF && !seen[$1]++')"
  dyn=$(mirror_dynamic android-ndk- ndk ghndk)
  [ -n "$dyn" ] || dyn=$(gh_dynamic "$NDK_CUSTOM_REPO" ndk ghndk)
  [ -n "$dyn" ] || dyn=$FALLBACK_NDK
  m="$m"$'\n'"$dyn"
  dyn=$(mirror_dynamic cmake- cmake ghcmake)
  [ -n "$dyn" ] || dyn=$(gh_dynamic "$CMAKE_CUSTOM_REPO" cmake ghcmake)
  [ -n "$dyn" ] || dyn=$FALLBACK_CMAKE
  m="$m"$'\n'"$dyn"
  case "$MANIFEST_URL" in
    *@*) ;; # nicht ersetzter Platzhalter
    *) remote=$(curl -fsSL --max-time 20 "$MANIFEST_URL" 2>/dev/null | tr -d '\r' | grep -v '^[[:space:]]*#' | grep '|' || true) ;;
  esac
  [ -n "$remote" ] && m="$m"$'\n'"$remote"
  printf '%s\n' "$m"
}

# gh_fetch_extract <zielordner>: lädt GH_URL, prüft ggf. die Prüfsumme, entpackt nach <zielordner>; setzt GH_ROOT
gh_fetch_extract() {
  local out=$1 file="$TMP/cfsdk-$GH_ASSET" got d
  progress 8 "Lade $GH_ASSET …"
  if [ -z "$GH_SHA" ] && [ -n "${GH_SHA_URL:-}" ]; then
    GH_SHA=$(curl -fsSL -m 25 "$GH_SHA_URL" 2>/dev/null | awk 'NR==1{print $1}')
    printf '%s' "$GH_SHA" | grep -Eq '^[0-9a-f]{64}$' || GH_SHA=""
  fi
  download "$GH_URL" "$file" 8 62 || { rm -f "$file"; return 1; }
  if [ -n "$GH_SHA" ]; then
    progress 72 "Prüfe Prüfsumme …"
    got=$(sha256sum "$file" | awk '{print $1}')
    [ "$got" = "$GH_SHA" ] || { rm -f "$file"; err "Prüfsumme stimmt nicht für $GH_ASSET (erwartet $GH_SHA, erhalten $got)"; return 1; }
  else
    say "Warnung: GitHub liefert keine Prüfsumme für $GH_ASSET – Download ist nicht verifiziert"
  fi
  progress 75 "Entpacke (kann dauern) …"
  extract "$file" "$out" 0 || { rm -f "$file"; err "Entpacken fehlgeschlagen: $GH_ASSET"; return 1; }
  rm -f "$file"
  GH_ROOT=$out
  d=$(find "$out" -mindepth 1 -maxdepth 1 | head -n 2)
  [ "$(printf '%s\n' "$d" | grep -c .)" = 1 ] && [ -d "$d" ] && GH_ROOT=$d
  return 0
}

# Termux-CMake für AGP registrieren: $SDK_ROOT/cmake/<version>/bin/{cmake,ninja}
link_cmake() {
  command -v cmake >/dev/null 2>&1 || return 1
  local v d
  v=$(cmake --version | head -n1 | awk '{print $3}'); [ -n "$v" ] || return 1
  [ -e "$SDK_ROOT/cmake/$v/bin/cmake" ] && [ ! -L "$SDK_ROOT/cmake/$v/bin/cmake" ] && return 1  # echte Installation gleicher Version
  d="$SDK_ROOT/cmake/$v/bin"
  mkdir -p "$d"
  printf '%s' "$v" > "$SDK_ROOT/cmake/.cf-termux"
  ln -sf "$(command -v cmake)" "$d/cmake"
  command -v ninja >/dev/null 2>&1 && ln -sf "$(command -v ninja)" "$d/ninja"
  printf 'Pkg.Revision = %s\nPkg.Path = cmake;%s\n' "$v" "$v" > "$SDK_ROOT/cmake/$v/source.properties"
}

# ---------- install / uninstall ----------
# Fallback für cmdline-tools: nur cmdline-tools/ temporär aus dem SDK-Archiv android-sdk-$CMDLINE_SDK_VER (Mirror) entpacken
cmdline_from_sdk_archive() {
  [ -n "$TOOLS_REPO" ] || { err "Kein Mirror (TOOLS_REPO leer) – cmdline-tools nicht verfügbar"; return 1; }
  local cx="$TMP/cfsdk-cmdline-extract" sm root dest="$SDK_ROOT/cmdline-tools/latest"
  progress 3 "Suche android-sdk-$CMDLINE_SDK_VER im Mirror …"
  gh_find_asset "$TOOLS_REPO" "$CMDLINE_SDK_VER" android-sdk- || return 1
  gh_fetch_extract "$cx" || { rm -rf "$cx"; return 1; }
  sm=$(find "$GH_ROOT" -type f -path '*/cmdline-tools/bin/sdkmanager' | head -n1)
  [ -n "$sm" ] || { rm -rf "$cx"; err "Kein cmdline-tools/bin/sdkmanager im Archiv $GH_ASSET"; return 1; }
  root=$(dirname "$(dirname "$sm")")
  progress 92 "Installiere cmdline-tools …"
  mkdir -p "$SDK_ROOT/cmdline-tools"; rm -rf "$dest"
  mv "$root" "$dest" || { rm -rf "$cx"; err "cmdline-tools konnten nicht verschoben werden"; return 1; }
  rm -rf "$cx"
  chmod -R u+x "$dest/bin" 2>/dev/null
  [ -x "$dest/bin/sdkmanager" ]
}

do_install() { # id
  local id=$1 kind ver src sha dest extra strip=0 url file tp=""
  if ! entry_exists "$id"; then
    case "$id" in
      *\;*) die "Unbekannte Komponente: $id" ;;
      *)
        progress 5 "Installiere Paket $id …"
        pkg_install "$id" || die "pkg install $id fehlgeschlagen"
        progress 100 "Fertig"
        ok "$id"
        return 0
        ;;
    esac
  fi
  kind=$(entry_field "$id" 3); ver=$(entry_field "$id" 2); src=$(entry_field "$id" 4)
  sha=$(entry_field "$id" 5); dest=$(entry_field "$id" 6); extra=$(entry_field "$id" 7)
  case "$extra" in *strip=*) strip=${extra##*strip=}; strip=${strip%%[!0-9]*} ;; esac
  : "${strip:=0}"
  case "$extra" in *tagprefix=*) tp=${extra##*tagprefix=}; tp=${tp%%[!A-Za-z0-9._-]*} ;; esac

  case "$kind" in
    pkg)
      progress 5 "Installiere Paket $src …"
      pkg_install "$src" || die "pkg install $src fehlgeschlagen"
      ;;
    archive)
      need_tools
      case "$src" in *://*) url=$src ;; *) url="$REPO_URL/$src" ;; esac
      file="$TMP/cfsdk-$(printf '%s' "$id" | tr -c 'A-Za-z0-9.' '_')-${src##*/}"
      progress 2 "Starte Download $(format_component_id "$id")"
      if ! download "$url" "$file" 2 78; then
        rm -f "$file"
        if [ "$id" = 'cmdline-tools;latest' ]; then
          say "Warnung: $url nicht erreichbar – Fallback: aus android-sdk-$CMDLINE_SDK_VER entpacken"
          cmdline_from_sdk_archive || exit 1
          return 0
        fi
        exit 1
      fi
      if [ -z "$sha" ] && [ "$id" = 'cmdline-tools;latest' ]; then
        sha=$(curl -fsSL -m 25 "$url.sha256" 2>/dev/null | awk 'NR==1{print $1}')
        printf '%s' "$sha" | grep -Eq '^[0-9a-f]{64}$' || sha=""
      fi
      if [ -n "$sha" ]; then
        progress 82 "Prüfe Prüfsumme …"
        local got; got=$(sha256sum "$file" | awk '{print $1}')
        [ "$got" = "$sha" ] || { rm -f "$file"; die "Prüfsumme stimmt nicht für $id (erwartet $sha, erhalten $got)"; }
      elif [ "$id" = 'cmdline-tools;latest' ]; then
        rm -f "$file"; die "Keine SHA-256 für cmdline-tools (weder CMDLINE_TOOLS_SHA256 in $CONF noch $url.sha256)"
      else
        say "Warnung: keine Prüfsumme im Manifest für $id"
      fi
      progress 88 "Entpacke …"
      extract "$file" "$SDK_ROOT/$dest" "$strip" || { rm -f "$file"; die "Entpacken fehlgeschlagen für $id"; }
      rm -f "$file"
      [ -d "$SDK_ROOT/$dest/bin" ] && chmod -R u+x "$SDK_ROOT/$dest/bin" 2>/dev/null
      ;;
    sdkmanager)
      local sm="$SDK_ROOT/cmdline-tools/latest/bin/sdkmanager"
      if [ ! -x "$sm" ]; then
        entry_exists 'cmdline-tools;latest' || die "cmdline-tools nicht konfiguriert (TOOLS_REPO leer?): CMDLINE_TOOLS_URL und CMDLINE_TOOLS_SHA256 in $CONF setzen"
        say "cmdline-tools fehlen — installiere sie zuerst"; ( do_install 'cmdline-tools;latest' ) || exit 1
      fi
      progress 10 "sdkmanager installiert $(format_component_id "$src") …"
      export JAVA_HOME="${JAVA_HOME:-$(first_jdk)}"
      yes 2>/dev/null | "$sm" --sdk_root="$SDK_ROOT" "$src" >/dev/null 2>&1 \
        || die "sdkmanager konnte $src nicht installieren"
      ;;
    cmake)
      progress 5 "Installiere cmake und ninja …"
      pkg_install cmake ninja || die "pkg install cmake ninja fehlgeschlagen"
      link_cmake || die "CMake konnte nicht für Gradle registriert werden"
      ;;
    ghndk)
      need_tools
      progress 3 "Suche NDK $ver bei GitHub …"
      gh_find_asset "$src" "$ver" "$tp" || exit 1
      say "NDK-Download ist groß (mehrere GB) und braucht beim Entpacken zusätzlich Platz."
      local nx="$TMP/cfsdk-ndk-extract" rev nd
      gh_fetch_extract "$nx" || { rm -rf "$nx"; exit 1; }
      [ -f "$GH_ROOT/source.properties" ] || { rm -rf "$nx"; die "source.properties im NDK nicht gefunden"; }
      rev=$(grep -E '^Pkg.Revision' "$GH_ROOT/source.properties" | cut -d= -f2 | tr -d ' \r')
      [ -n "$rev" ] || { rm -rf "$nx"; die "Pkg.Revision im NDK nicht lesbar"; }
      progress 90 "Installiere NDK $rev …"
      mkdir -p "$SDK_ROOT/ndk"; rm -rf "$SDK_ROOT/ndk/$rev"
      mv "$GH_ROOT" "$SDK_ROOT/ndk/$rev" || { rm -rf "$nx"; die "NDK konnte nicht verschoben werden"; }
      rm -rf "$nx"
      nd="$SDK_ROOT/ndk/$rev"
      printf '%s' "$rev" > "$SDK_ROOT/ndk/.cf-$ver"
      ln -sfn "$nd" "$SDK_ROOT/ndk-bundle"
      find "$nd/toolchains" -path '*/bin/*' -type f -exec chmod +x {} + 2>/dev/null
      local clang; clang=$(find "$nd/toolchains/llvm/prebuilt" -path '*/bin/clang' 2>/dev/null | head -n1)
      if [ -n "$clang" ] && "$clang" --version >/dev/null 2>&1; then say "NDK-clang: $("$clang" --version | head -n1)"
      else say "Warnung: NDK-clang startet nicht – Asset-Variante prüfen (ASSET_VARIANT=$GH_VARIANT)"; fi
      ;;
    ghcmake)
      need_tools
      local cx="$TMP/cfsdk-cmake-extract" cmbin croot cdir
      progress 3 "Suche CMake $ver bei GitHub …"
      gh_find_asset "$src" "$ver" "$tp" || exit 1
      gh_fetch_extract "$cx" || { rm -rf "$cx"; exit 1; }
      cmbin=$(find "$GH_ROOT" -type f -path '*/bin/cmake' | head -n1)
      [ -n "$cmbin" ] || { rm -rf "$cx"; die "bin/cmake im CMake-Archiv nicht gefunden"; }
      croot=$(dirname "$(dirname "$cmbin")")
      cdir="$SDK_ROOT/cmake/$ver"
      progress 90 "Installiere CMake $ver …"
      mkdir -p "$SDK_ROOT/cmake"; rm -rf "$cdir"
      mv "$croot" "$cdir" || { rm -rf "$cx"; die "CMake konnte nicht verschoben werden"; }
      rm -rf "$cx"
      chmod +x "$cdir"/bin/* 2>/dev/null
      if [ ! -x "$cdir/bin/ninja" ]; then
        command -v ninja >/dev/null 2>&1 || pkg_install ninja
        if command -v ninja >/dev/null 2>&1; then ln -sf "$(command -v ninja)" "$cdir/bin/ninja"
        else say "Warnung: ninja fehlt (pkg install ninja)"; fi
      fi
      printf 'Pkg.Revision = %s\nPkg.Path = cmake;%s\n' "$ver" "$ver" > "$cdir/source.properties"
      "$cdir/bin/cmake" --version >/dev/null 2>&1 || say "Warnung: cmake startet nicht – Asset-Variante prüfen (ASSET_VARIANT=$GH_VARIANT)"
      ;;
    ghpt|ghaidept)
      need_tools
      local px="$TMP/cfsdk-pt-extract" padb
      progress 6 "Suche platform-tools $ver bei GitHub …"
      gh_find_asset "$src" "$ver" "$tp" "$(asset_re_for "$tp" "$kind" "$ver")" || exit 1
      gh_fetch_extract "$px" || { rm -rf "$px"; exit 1; }
      padb=$(find "$GH_ROOT" -type f -name adb | head -n1)
      [ -n "$padb" ] || { rm -rf "$px"; die "adb im Archiv nicht gefunden"; }
      # platform-tools gibt es nur einmal: ersetzen statt überlagern, sonst mischen sich die Versionen
      rm -rf "$SDK_ROOT/platform-tools"; mkdir -p "$SDK_ROOT/platform-tools"
      cp -a "$(dirname "$padb")"/. "$SDK_ROOT/platform-tools"/
      find "$SDK_ROOT/platform-tools" -maxdepth 1 -type f ! -name '*.properties' -exec chmod +x {} + 2>/dev/null
      printf '%s' "$ver" > "$SDK_ROOT/platform-tools/.cf-version"
      rm -rf "$px"
      "$SDK_ROOT/platform-tools/adb" version >/dev/null 2>&1 || say "Warnung: adb startet nicht – Quelle/Variante prüfen"
      ;;
    ghaidebt)
      need_tools
      local ax="$TMP/cfsdk-aide-extract" aapt2src bdir
      progress 6 "Suche build-tools $ver (androidide-tools) …"
      gh_find_asset "$src" "$ver" "$tp" "$(asset_re_for "$tp" "$kind" "$ver")" || exit 1
      gh_fetch_extract "$ax" || { rm -rf "$ax"; exit 1; }
      aapt2src=$(find "$GH_ROOT" -type f -name aapt2 | head -n1)
      [ -n "$aapt2src" ] || { rm -rf "$ax"; die "aapt2 im Archiv nicht gefunden"; }
      bdir="$SDK_ROOT/build-tools/$ver"
      progress 90 "Installiere build-tools $ver …"
      mkdir -p "$SDK_ROOT/build-tools"; rm -rf "$bdir"
      mv "$(dirname "$aapt2src")" "$bdir" || { rm -rf "$ax"; die "build-tools konnten nicht verschoben werden"; }
      rm -rf "$ax"
      find "$bdir" -maxdepth 2 -type f ! -name '*.jar' ! -name '*.xml' ! -name '*.properties' ! -name '*.txt' -exec chmod +x {} + 2>/dev/null
      [ -f "$bdir/source.properties" ] || printf 'Pkg.Desc = Android SDK Build-Tools %s (%s)\nPkg.Revision = %s\n' "$ver" "$CF_ARCH" "$ver" > "$bdir/source.properties"
      "$bdir/aapt2" version >/dev/null 2>&1 || say "Warnung: aapt2 startet nicht – Quelle/Variante prüfen (AIDE_VARIANT=$AIDE_VARIANT)"
      ;;
    ghsdk)
      need_tools
      local bt="$SDK_ROOT/build-tools/$ver" sm="$SDK_ROOT/cmdline-tools/latest/bin/sdkmanager" sx="$TMP/cfsdk-sdk-extract" aapt2 adb
      # a) Java-Teile und Metadaten der offiziellen build-tools (sdkmanager), falls verfügbar
      if [ ! -x "$sm" ] && entry_exists 'cmdline-tools;latest'; then ( do_install 'cmdline-tools;latest' ) || say "Warnung: cmdline-tools konnten nicht installiert werden"; fi
      if [ -x "$sm" ]; then
        progress 4 "sdkmanager installiert build-tools $ver …"
        export JAVA_HOME="${JAVA_HOME:-$(first_jdk)}"
        yes 2>/dev/null | "$sm" --sdk_root="$SDK_ROOT" "build-tools;$ver" >/dev/null 2>&1 \
          || say "Warnung: build-tools $ver bei Google nicht verfügbar – nur die $CF_ARCH-Binaries werden genutzt"
      else
        say "Warnung: kein sdkmanager – build-tools enthalten nur die $CF_ARCH-Binaries"
      fi
      # b) native Binaries (aarch64 bzw. arm) einspielen
      progress 6 "Suche SDK-Binaries $ver bei GitHub …"
      gh_find_asset "$src" "$ver" "$tp" "$(asset_re_for "$tp" "$kind" "$ver")" || exit 1
      gh_fetch_extract "$sx" || { rm -rf "$sx"; exit 1; }
      aapt2=$(find "$GH_ROOT" -type f -name aapt2 | head -n1)
      adb=$(find "$GH_ROOT" -type f -name adb | head -n1)
      [ -n "$aapt2" ] || { rm -rf "$sx"; die "aapt2 im SDK-Archiv nicht gefunden"; }
      mkdir -p "$bt"; cp -a "$(dirname "$aapt2")"/. "$bt"/
      find "$bt" -maxdepth 2 -type f ! -name '*.jar' ! -name '*.xml' ! -name '*.properties' -exec chmod +x {} + 2>/dev/null
      if [ -n "$adb" ]; then
        mkdir -p "$SDK_ROOT/platform-tools"; cp -a "$(dirname "$adb")"/. "$SDK_ROOT/platform-tools"/
        find "$SDK_ROOT/platform-tools" -maxdepth 1 -type f ! -name '*.properties' -exec chmod +x {} + 2>/dev/null
      fi
      rm -rf "$sx"
      [ -f "$bt/source.properties" ] || printf 'Pkg.Desc = Android SDK Build-Tools %s (%s)\nPkg.Revision = %s\n' "$ver" "$CF_ARCH" "$ver" > "$bt/source.properties"
      "$bt/aapt2" version >/dev/null 2>&1 || say "Warnung: aapt2 startet nicht – Asset-Variante prüfen (ASSET_VARIANT=$GH_VARIANT)"
      [ -f "$bt/lib/d8.jar" ] || say "Warnung: d8.jar fehlt in build-tools $ver (Google bietet diese Version nicht an?) – Gradle/AGP nutzt eigene Kopien"
      ;;
    *) die "Unbekannter Typ '$kind' im Manifest für $id" ;;
  esac
  progress 100 "Fertig"
  ok "$id"
}

do_uninstall() { # id
  local id=$1 kind src p
  entry_exists "$id" || die "Unbekannte Komponente: $id"
  kind=$(entry_field "$id" 3); src=$(entry_field "$id" 4)
  p=$(installed_path "$id")
  [ -n "$p" ] || { ok "$id"; return 0; }
  case "$kind" in
    pkg) pkg uninstall -y "$src" >/dev/null 2>&1 || die "Deinstallation von $src fehlgeschlagen" ;;
    archive) rm -rf "$p" ;;
    sdkmanager) rm -rf "$p" ;;
    cmake) rm -rf "$p" "$SDK_ROOT/cmake/.cf-termux" ;;   # Symlinks; die Termux-Pakete cmake/ninja bleiben installiert
    ghcmake) rm -rf "$p" ;;
    ghsdk|ghaidebt) rm -rf "$p" ;;   # nur build-tools/<version>
    ghpt|ghaidept) rm -rf "$p" ;;
    ghndk) rm -rf "$p" "$SDK_ROOT/ndk/.cf-$(entry_field "$id" 2)"
           [ -e "$SDK_ROOT/ndk-bundle" ] || rm -f "$SDK_ROOT/ndk-bundle" ;;
  esac
  ok "$id"
}

first_jdk() { local d; for d in "$JVM_DIR"/java-*-openjdk; do [ -x "$d/bin/java" ] && { printf '%s' "$d"; return; }; done; }

# ---------- list ----------
do_list() {
  local line id ver kind p inst
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    id=${line%%|*}; ver=$(entry_field "$id" 2)
    p=$(installed_path "$id"); inst=0; [ -n "$p" ] && inst=1
    if [ "$MACHINE" = 1 ]; then printf 'CFSDK|ITEM|%s|%s|%s|%s\n' "$id" "$ver" "$inst" "$p"
    else printf '%-28s %-12s %s\n' "$id" "$ver" "$([ "$inst" = 1 ] && echo "installiert ($p)" || echo '-')"; fi
  done < <(manifest | awk -F'|' '!seen[$1]++{print $1}')
}

# ---------- env ----------
write_env() { # jdkVer ndkId cmakeId
  local jdkver=$1 ndk=${2:-} cmake=${3:-} jh p
  jh=$(jdk_home "$jdkver"); [ -x "$jh/bin/java" ] || jh=$(first_jdk)
  mkdir -p "$(dirname "$ENV_FILE")"
  {
    echo "# erzeugt von codeforge-env — nicht von Hand ändern"
    echo "export ANDROID_HOME=\"$SDK_ROOT\""
    echo "export ANDROID_SDK_ROOT=\"$SDK_ROOT\""
    [ -n "$jh" ] && echo "export JAVA_HOME=\"$jh\""
    if [ -n "$ndk" ]; then p=$(installed_path "$ndk"); [ -n "$p" ] && echo "export ANDROID_NDK_HOME=\"$p\""; fi
    local path_add="$SDK_ROOT/cmdline-tools/latest/bin:$SDK_ROOT/platform-tools"
    if [ -n "$cmake" ]; then p=$(installed_path "$cmake"); [ -n "$p" ] && path_add="$p/bin:$path_add"; fi
    echo "export PATH=\"$path_add:\$PATH\""
  } > "$ENV_FILE"
  # Gradle braucht ein aapt2, das auf dem Gerät läuft: das aapt2 (aarch64 bzw. arm) aus den eigenen build-tools
  # (build-tools), sonst ein Termux-Paket 'aapt2'. Das x86-aapt2 von Google/Maven läuft hier nicht.
  local bt aapt2
  bt=$(ls -d "$SDK_ROOT"/build-tools/* 2>/dev/null | sort -V | tail -n1)
  aapt2="$bt/aapt2"
  [ -n "$bt" ] && [ -x "$aapt2" ] || aapt2="$PREFIX/bin/aapt2"
  if [ -x "$aapt2" ]; then
    mkdir -p "$HOME/.gradle"
    local gp="$HOME/.gradle/gradle.properties"
    grep -v '^android.aapt2FromMavenOverride=' "$gp" 2>/dev/null > "$gp.new" || true
    echo "android.aapt2FromMavenOverride=$aapt2" >> "$gp.new"; mv "$gp.new" "$gp"
  fi
}

ALLOWED_REPAIR_PKGS="dpkg-perl dpkg-scanpackages doxygen docbook-xml docbook-xsl xsltproc tor apt-transport-tor unbound pyunbound swig python-tkinter ca-certificates-java"

is_allowed_repair_pkg() {
  local p=$1 allowed
  for allowed in $ALLOWED_REPAIR_PKGS; do
    if [ "$p" = "$allowed" ]; then
      return 0
    fi
  done
  return 1
}

check_dpkg_consistency() {
  if ! command -v apt-get >/dev/null 2>&1; then
    return 0
  fi
  local chk_out chk_rc=0
  chk_out=$(LANG=C apt-get check 2>&1) || chk_rc=$?
  if [ "$chk_rc" -ne 0 ]; then
    mkdir -p "$LOG_DIR" 2>/dev/null
    {
      printf '\n=== [%s] apt-get check FEHLGESCHLAGEN (Exit-Code %s) ===\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$chk_rc"
      printf '%s\n' "$chk_out"
    } >> "$LOG_FILE" 2>/dev/null

    err "Defekter Paketzustand erkannt (apt-get check meldet Fehler)!"
    local dep_line
    dep_line=$(printf '%s\n' "$chk_out" | grep -E -i 'Depends:' | head -n 1)
    if [ -n "$dep_line" ]; then
      say "Unerfüllte Abhängigkeit:"
      say "  $dep_line"
    else
      say "Fehlerausgabe:"
      printf '%s\n' "$chk_out" | grep -E '(unmet|Depends|broken|E:)' | head -n 5 >&2
    fi
    say ""
    say "Hinweis: Bitte führen Sie zur Reparatur folgenden Befehl aus:"
    say "  codeforge-env repair"
    say ""
    die "Einrichtung abgebrochen wegen inkonsistentem Paketzustand. Details in $LOG_FILE"
  fi
  return 0
}

do_repair() {
  local auto_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) auto_yes=1; shift ;;
      *) die "Unbekannte Option für repair: $1" ;;
    esac
  done

  mkdir -p "$LOG_DIR" 2>/dev/null
  {
    printf '\n=== [%s] codeforge-env repair gestartet ===\n' "$(date '+%Y-%m-%d %H:%M:%S')"
  } >> "$LOG_FILE" 2>/dev/null

  if ! command -v apt-get >/dev/null 2>&1; then
    die "apt-get ist nicht verfügbar"
  fi

  local chk_out chk_rc=0
  chk_out=$(LANG=C apt-get check 2>&1) || chk_rc=$?
  if [ "$chk_rc" -eq 0 ]; then
    say "Paketzustand ist konsistent, keine Reparatur erforderlich."
    return 0
  fi

  {
    printf 'apt-get check Vorprüfung (Exit %s):\n%s\n' "$chk_rc" "$chk_out"
  } >> "$LOG_FILE" 2>/dev/null

  # Ermitteln der defekten Pakete
  local broken_pkgs=()
  while IFS= read -r line; do
    [ -n "$line" ] && broken_pkgs+=("$line")
  done < <(printf '%s\n' "$chk_out" | awk '
    /The following packages have unmet dependencies:/ {flag=1; next}
    /^E:/ {flag=0}
    flag && /^[[:space:]]+[a-zA-Z0-9.+-]+[[:space:]]*:/ {
      sub(/^[[:space:]]+/, "");
      sub(/[[:space:]]*:.*$/, "");
      print;
    }
  ' | sort -u)

  # Fallback: Falls keine Pakete über das Parsing gefunden wurden, versuche dpkg -C
  if [ ${#broken_pkgs[@]} -eq 0 ] && command -v dpkg >/dev/null 2>&1; then
    local dpkg_c
    dpkg_c=$(dpkg -C 2>/dev/null || true)
    while IFS= read -r line; do
      [ -n "$line" ] && broken_pkgs+=("$line")
    done < <(printf '%s\n' "$dpkg_c" | awk '/^[[:space:]]+[a-zA-Z0-9.+-]+/{print $1}' | sort -u)
  fi

  if [ ${#broken_pkgs[@]} -eq 0 ]; then
    err "apt-get check meldet Fehler, aber die betroffenen Pakete konnten nicht automatisch ermittelt werden:"
    printf '%s\n' "$chk_out" >&2
    say "Bitte prüfen Sie das System manuell mit 'apt-get -f install'."
    exit 1
  fi

  # Falls dpkg-perl defekt ist und dpkg-scanpackages installiert ist, nehmen wir dpkg-scanpackages mit auf
  if command -v dpkg >/dev/null 2>&1; then
    for pkg in "${broken_pkgs[@]}"; do
      if [ "$pkg" = "dpkg-perl" ]; then
        if dpkg -s dpkg-scanpackages 2>/dev/null | grep -q 'Status:.*installed'; then
          local already_in=0 sp
          for sp in "${broken_pkgs[@]}"; do [ "$sp" = "dpkg-scanpackages" ] && already_in=1; done
          if [ "$already_in" -eq 0 ]; then
            broken_pkgs+=("dpkg-scanpackages")
            say "Beziehe abhängiges Paket 'dpkg-scanpackages' in die Reparatur ein."
          fi
        fi
      fi
    done
  fi

  say "Gefundene defekte Pakete: ${broken_pkgs[*]}"

  # Sicherheitsprüfung: Dürfen alle gefundenen Pakete repariert werden?
  local pkg
  for pkg in "${broken_pkgs[@]}"; do
    if ! is_allowed_repair_pkg "$pkg"; then
      err "Sicherheitsabbruch: Das defekte Paket '$pkg' ist nicht in der Liste der reparierbaren Pakete!"
      say "Erlaubte Pakete: $ALLOWED_REPAIR_PKGS"
      say "Dieses Paket gehört nicht zu den bekannten Bootstrap-Inkonsistenzen."
      say "Bitte prüfen Sie das Paket manuell mit 'apt-get check' oder 'dpkg -C'."
      {
        printf 'Sicherheitsabbruch: %s nicht in ALLOWED_REPAIR_PKGS\n' "$pkg"
      } >> "$LOG_FILE" 2>/dev/null
      exit 1
    fi
  done

  # Rückfrage falls nicht --yes
  if [ "$auto_yes" -ne 1 ]; then
    printf "Möchten Sie die defekten Pakete (%s) entfernen? [j/N] " "${broken_pkgs[*]}"
    local answer
    read -r answer
    case "$answer" in
      [jJyY]|[jJ][aA]|[yY][eE][sS]) ;;
      *)
        say "Reparatur abgebrochen."
        return 0
        ;;
    esac
  fi

  # Entfernen der defekten Pakete mit dpkg --remove --force-depends
  say "Entferne defekte Pakete (${broken_pkgs[*]})..."
  {
    printf 'Entferne mit dpkg --remove --force-depends: %s\n' "${broken_pkgs[*]}"
  } >> "$LOG_FILE" 2>/dev/null

  if ! dpkg --remove --force-depends "${broken_pkgs[@]}" >> "$LOG_FILE" 2>&1; then
    err "Fehler beim Entfernen mit dpkg --remove --force-depends!"
    say "Logdatei: $LOG_FILE"
    exit 1
  fi

  # Bereinigung mit apt-get -f install -y
  say "Bereinige Abhängigkeiten (apt-get -f install)..."
  {
    printf 'Bereinige mit apt-get -f install -y\n'
  } >> "$LOG_FILE" 2>/dev/null

  if ! DEBIAN_FRONTEND=noninteractive apt-get "${APT_OPTS[@]}" -f install -y >> "$LOG_FILE" 2>&1; then
    err "apt-get -f install fehlgeschlagen!"
    say "Logdatei: $LOG_FILE"
    exit 1
  fi

  # Erneuter Check
  say "Überprüfe Paketzustand erneut..."
  chk_rc=0
  chk_out=$(LANG=C apt-get check 2>&1) || chk_rc=$?
  {
    printf 'apt-get check Nachprüfung (Exit %s):\n%s\n' "$chk_rc" "$chk_out"
  } >> "$LOG_FILE" 2>/dev/null

  if [ "$chk_rc" -ne 0 ]; then
    err "Reparatur unvollständig: apt-get check meldet weiterhin Fehler!"
    printf '%s\n' "$chk_out" >&2
    say "Logdatei: $LOG_FILE"
    exit 1
  fi

  say "Reparatur erfolgreich abgeschlossen. Der Paketzustand ist wieder konsistent."
  ok repair
}

do_setup() {
  check_dpkg_consistency
  local setup_args="$*"
  local retry_cmd="codeforge-env setup${setup_args:+ $setup_args}"
  CURRENT_SETUP_RETRY_CMD="$retry_cmd"
  local jdk=21 ndk=r29 cmake=4.1.2 sdk=37.0.0 platform=36 want_ndk=1 want_cmake=1 want_gradle=1 want_kotlin=1 want_extras=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --jdk) jdk=$2; shift 2 ;; --ndk) ndk=$2; shift 2 ;; --cmake) cmake=$2; shift 2 ;;
      --sdk) sdk=$2; shift 2 ;; --platform) platform=$2; shift 2 ;;
      --no-ndk) want_ndk=0; shift ;; --no-cmake) want_cmake=0; shift ;;
      --gradle) want_gradle=1; shift ;; --no-gradle) want_gradle=0; shift ;;
      --kotlin) want_kotlin=1; shift ;; --no-kotlin) want_kotlin=0; shift ;;
      --extras) want_extras=1; shift ;; --no-extras) want_extras=0; shift ;;
      --minimal) want_gradle=0; want_kotlin=0; want_extras=0; shift ;;
      *) die "Unbekannte Option: $1" ;;
    esac
  done
  pkg_update_once
  # NDK: '27d' wird zu 'r27d'; gibt es genau diese Version nicht (z. B. 'r29d'), gilt das Release gleicher Hauptversion ('r29').
  case "$ndk" in [0-9]*) ndk="r$ndk" ;; esac
  if [ "$want_ndk" = 1 ] && ! entry_exists "ndk;$ndk"; then
    local nbase nalt
    nbase=$(printf '%s' "$ndk" | sed -E 's/^(r[0-9]+).*/\1/')
    nalt=$(manifest | awk -F'|' -v b="ndk;$nbase" '$1 ~ ("^" b "[a-z]?$") {print $1; exit}')
    if [ -n "$nalt" ]; then say "NDK $ndk nicht vorhanden – verwende ${nalt#ndk;}"; ndk=${nalt#ndk;}; fi
  fi
  # CMake: gewünschte Version, sonst das Termux-Paket
  if [ "$want_cmake" = 1 ] && ! entry_exists "cmake;$cmake"; then
    say "CMake $cmake nicht verfügbar – verwende das Termux-Paket"; cmake=termux
  fi
  local steps=("jdk;$jdk" 'cmdline-tools;latest' "build-tools;$sdk" "platform-tools;$sdk" "platforms;android-$platform")
  [ "$want_ndk" = 1 ] && steps+=("ndk;$ndk")
  [ "$want_cmake" = 1 ] && steps+=("cmake;$cmake")
  local total=${#steps[@]} i=0 id label
  for id in "${steps[@]}"; do
    i=$((i+1))
    label=$(format_component_id "$id")
    if ! entry_exists "$id"; then say "Überspringe $label (nicht im Manifest)"; continue; fi
    if [ -n "$(installed_path "$id")" ]; then say "$label bereits installiert"; continue; fi
    say "== ($i/$total) $label =="
    if ! ( CURRENT_SETUP_RETRY_CMD="" do_install "$id" ); then
      err "Einrichtung abgebrochen bei $label ($id)"
      say "Logdatei: $LOG_FILE"
      say "Erneut versuchen: $retry_cmd"
      exit 1
    fi
  done
  # Basis-Werkzeuge außerhalb des SDK: Gradle, Kotlin-Compiler, git/zip/unzip.
  # Jedes Werkzeug einzeln: bereits vorhandene werden übersprungen, Fehler brechen mit Hinweis ab.
  setup_tool() { # <befehl> <anzeigename> <paket…>
    local bin=$1 label=$2; shift 2
    if command -v "$bin" >/dev/null 2>&1; then say "$label bereits installiert"; return 0; fi
    say "== $label =="
    if ! ( CURRENT_SETUP_RETRY_CMD="" pkg_install "$@" ); then
      err "Einrichtung abgebrochen bei $label"
      say "Logdatei: $LOG_FILE"
      say "Erneut versuchen: $retry_cmd"
      exit 1
    fi
  }
  [ "$want_gradle" = 1 ] && setup_tool gradle "Gradle" gradle
  [ "$want_kotlin" = 1 ] && setup_tool kotlinc "Kotlin-Compiler" kotlin
  if [ "$want_extras" = 1 ]; then
    setup_tool git "git" git
    setup_tool zip "zip" zip
    setup_tool unzip "unzip" unzip
  fi
  write_env "$jdk" "$( [ "$want_ndk" = 1 ] && echo "ndk;$ndk")" "$( [ "$want_cmake" = 1 ] && echo "cmake;$cmake")"
  progress 100 "Umgebung eingerichtet"
  say "Neue Shell öffnen oder 'source $ENV_FILE' ausführen."
  ok setup
}

do_doctor() {
  local rc=0 t
  for t in bash curl tar unzip java jq; do command -v "$t" >/dev/null 2>&1 && say "ok   $t" || { say "FEHLT $t"; rc=1; }; done
  [ -d "$SDK_ROOT" ] && say "ok   SDK_ROOT=$SDK_ROOT" || { say "FEHLT SDK_ROOT"; rc=1; }
  [ -f "$ENV_FILE" ] && say "ok   $ENV_FILE" || { say "FEHLT $ENV_FILE (codeforge-env setup)"; rc=1; }
  case "$MANIFEST_URL" in *@*) say "WARN  CODEFORGE_SDK_REPO ist nicht konfiguriert ($CONF)"; rc=1 ;; esac
  exit $rc
}

cmd=${1:-help}; [ $# -gt 0 ] && shift
case "$cmd" in
  list|install|uninstall|setup)
    check_dpkg_consistency
    command -v jq >/dev/null 2>&1 || pkg_install jq || true
    MANIFEST_CACHE=$(build_manifest)
    ;;
esac
case "$cmd" in
  list) do_list ;;
  install) [ $# -ge 1 ] || die "install braucht eine ID"; do_install "$1" ;;
  uninstall) [ $# -ge 1 ] || die "uninstall braucht eine ID"; do_uninstall "$1" ;;
  pkg) [ $# -ge 1 ] || die "pkg braucht mindestens einen Paketnamen"; check_dpkg_consistency; pkg_install "$@" || exit 1; ok "$*" ;;
  setup) do_setup "$@" ;;
  repair) do_repair "$@" ;;
  env) [ -f "$ENV_FILE" ] && cat "$ENV_FILE" || die "Noch nicht eingerichtet (codeforge-env setup)" ;;
  doctor) do_doctor ;;
  help|-h|--help) sed -n '2,/^# Quellen:/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' ;;
  *) die "Unbekannter Befehl: $cmd (codeforge-env help)" ;;
esac
