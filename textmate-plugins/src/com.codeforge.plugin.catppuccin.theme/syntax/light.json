{
  "name": "Catppuccin Light",
  "type": "light",
  "colors": {
    "editor.background": "#EFF1F5",
    "editor.foreground": "#4C4F69",
    "editor.selectionBackground": "#CCD0DA",
    "editor.inactiveSelectionBackground": "#DADDE5",
    "editor.lineHighlightBackground": "#E5E7ED",
    "editor.findMatchBackground": "#C19EF2",
    "editor.findMatchHighlightBackground": "#D5C3F4",
    "editorCursor.foreground": "#8839EF",
    "editorLineNumber.foreground": "#B1B3C0",
    "editorLineNumber.activeForeground": "#6D6F85",
    "editorIndentGuide.background1": "#DBDEE4",
    "editorIndentGuide.activeBackground1": "#BEC0CB",
    "editorWhitespace.foreground": "#D2D4DC",
    "editorBracketMatch.background": "#D0BAF3"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#4C4F69",
        "background": "#EFF1F5"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9CA0B0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#40A02B"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#04A5E5"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#FE640B"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8839EF"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#04A5E5"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#1E66F5"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#DF8E1D"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.section",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#DF8E1D"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#4C4F69"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#966E43",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#D20F39"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#DF8E1D"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#6D6F85"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#1E66F5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#8839EF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#8839EF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#40A02B"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#40A02B"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#D20F39"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#D20F39"
      }
    }
  ]
}
