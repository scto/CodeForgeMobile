{
  "name": "Everforest Light",
  "type": "light",
  "colors": {
    "editor.background": "#FDF6E3",
    "editor.foreground": "#5C6A72",
    "editor.selectionBackground": "#E6E2CC",
    "editor.inactiveSelectionBackground": "#EFEAD5",
    "editor.lineHighlightBackground": "#F3EEDC",
    "editor.findMatchBackground": "#BDC27D",
    "editor.findMatchHighlightBackground": "#DAD9AA",
    "editorCursor.foreground": "#6F8200",
    "editorLineNumber.foreground": "#C0C1B8",
    "editorLineNumber.activeForeground": "#7C8689",
    "editorIndentGuide.background1": "#EAE5D5",
    "editorIndentGuide.activeBackground1": "#CDCCC1",
    "editorWhitespace.foreground": "#E0DDCF",
    "editorBracketMatch.background": "#D2D39F"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#5C6A72",
        "background": "#FDF6E3"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#939F91",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6F8200"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#F57D26"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#DF69BA"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F85552"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#F57D26"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#35A77C"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#BF8600"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.section",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#BF8600"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#5C6A72"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#8E7839",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#F57D26"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#BF8600"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#7C8689"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#35A77C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F85552",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#F85552",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#6F8200"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#DF69BA"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#F85552"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F85552"
      }
    }
  ]
}
