{
  "name": "Kanagawa Light",
  "type": "light",
  "colors": {
    "editor.background": "#F2ECBC",
    "editor.foreground": "#545464",
    "editor.selectionBackground": "#C9CBD1",
    "editor.inactiveSelectionBackground": "#D9D8C9",
    "editor.lineHighlightBackground": "#E9E3B7",
    "editor.findMatchBackground": "#A8B1AD",
    "editor.findMatchHighlightBackground": "#C9CBB4",
    "editorCursor.foreground": "#4D699B",
    "editorLineNumber.foreground": "#B6B29B",
    "editorLineNumber.activeForeground": "#747276",
    "editorIndentGuide.background1": "#DFDAB1",
    "editorIndentGuide.activeBackground1": "#C3BEA2",
    "editorWhitespace.foreground": "#D6D1AC",
    "editorBracketMatch.background": "#C0C5B2"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#545464",
        "background": "#F2ECBC"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8A8980",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6F894E"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#836F4A"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#B35B79"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#624C83"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#836F4A"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#4D699B"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#597B75"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.section",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#597B75"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#545464"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#666252",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#77713F"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#77713F"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#747276"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#4D699B",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#624C83",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#624C83",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#6F894E"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#6F894E"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#C84053"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#C84053"
      }
    }
  ]
}
