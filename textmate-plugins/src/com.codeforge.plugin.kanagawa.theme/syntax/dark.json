{
  "name": "Kanagawa Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1F1F28",
    "editor.foreground": "#DCD7BA",
    "editor.selectionBackground": "#2D4F67",
    "editor.inactiveSelectionBackground": "#273C4E",
    "editor.lineHighlightBackground": "#2A2A31",
    "editor.findMatchBackground": "#4A5777",
    "editor.findMatchHighlightBackground": "#373E54",
    "editorCursor.foreground": "#7E9CD8",
    "editorLineNumber.foreground": "#67655F",
    "editorLineNumber.activeForeground": "#B6B29D",
    "editorIndentGuide.background1": "#36353A",
    "editorIndentGuide.activeBackground1": "#585654",
    "editorWhitespace.foreground": "#414042",
    "editorBracketMatch.background": "#3C445D"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#DCD7BA",
        "background": "#1F1F28"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#727169",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#98BB6C"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#C0A36E"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#D27E99"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#957FB8"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#C0A36E"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7E9CD8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#7AA89F"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.section",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#7AA89F"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#DCD7BA"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#E1CD9F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#E6C384"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E6C384"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#B6B29D"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#7E9CD8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#957FB8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#957FB8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#98BB6C"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#98BB6C"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#E46876"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E46876"
      }
    }
  ]
}
