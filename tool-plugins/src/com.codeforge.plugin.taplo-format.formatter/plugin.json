{
  "id": "com.codeforge.plugin.taplo-format.formatter",
  "name": "Taplo Format (Formatierer)",
  "version": "1.0.0",
  "apiVersion": 2,
  "publisher": "codeforge",
  "description": "Formatiert toml mit Taplo Format. Fehlende Programme installiert die App nach Bestätigung (sonst: pkg install taplo).",
  "permissions": [],
  "contributes": {
    "formatters": [
      {
        "id": "taplo-format",
        "label": "Taplo Format",
        "extensions": [
          "toml"
        ],
        "command": [
          "taplo",
          "format",
          "-"
        ],
        "timeoutSeconds": 20
      }
    ],
    "requires": [
      {
        "manager": "pkg",
        "name": "taplo"
      }
    ]
  }
}
