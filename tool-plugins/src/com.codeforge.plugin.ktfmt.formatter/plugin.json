{
  "id": "com.codeforge.plugin.ktfmt.formatter",
  "name": "ktfmt (Formatierer)",
  "version": "1.0.1",
  "apiVersion": 2,
  "publisher": "codeforge",
  "description": "Formatiert Kotlin mit ktfmt 0.65 (Kotlinlang-, Google- oder Meta-Stil). Einstellungsseite für Stil, Importe, .editorconfig (Breite/Einzüge) und Speicher.",
  "permissions": [],
  "contributes": {
    "formatters": [
      {
        "id": "ktfmt",
        "label": "ktfmt",
        "extensions": [
          "kt",
          "kts"
        ],
        "command": [
          "java",
          "-Xmx${setting:heapMb}m",
          "-XX:+UseSerialGC",
          "-XX:TieredStopAtLevel=1",
          "-jar",
          "${deps}/ktfmt/ktfmt.jar",
          "${setting:style=kotlinlang?--kotlinlang-style}",
          "${setting:style=google?--google-style}",
          "${setting:style=meta?--meta-style}",
          "${setting:removeUnused=false?--do-not-remove-unused-imports}",
          "${setting:editorconfig?--enable-editorconfig}",
          "--quiet",
          "--stdin-name=${file}",
          "-"
        ],
        "timeoutSeconds": 60
      }
    ],
    "requires": [
      {
        "manager": "pkg",
        "name": "openjdk-17",
        "check": "java"
      },
      {
        "manager": "download",
        "name": "ktfmt",
        "url": "https://github.com/Kotlin/ktfmt/releases/download/v0.65/ktfmt-0.65-with-dependencies.jar",
        "sha256": "aba9753b6ab387926179ab7318ba8e0c33dad483ebc72f633e79522265b15214",
        "archive": "file",
        "check": "ktfmt.jar"
      }
    ],
    "settings": {
      "title": "ktfmt",
      "items": [
        {
          "key": "style",
          "type": "choice",
          "title": "Stil",
          "default": "kotlinlang",
          "description": "Kotlinlang: 4 Leerzeichen (offizielle Konventionen). Google/Meta: 2 Leerzeichen. Zeilenbreite jeweils 100.",
          "options": [
            {
              "value": "kotlinlang",
              "label": "Kotlinlang (4 Leerzeichen)"
            },
            {
              "value": "google",
              "label": "Google (2 Leerzeichen)"
            },
            {
              "value": "meta",
              "label": "Meta (2 Leerzeichen)"
            }
          ]
        },
        {
          "key": "removeUnused",
          "type": "boolean",
          "title": "Unbenutzte Importe entfernen",
          "description": "Aus: --do-not-remove-unused-imports",
          "default": "true"
        },
        {
          "key": "editorconfig",
          "type": "boolean",
          "title": ".editorconfig beachten",
          "description": "Zeilenbreite und Einzüge aus der .editorconfig des Projekts: max_line_length, ij_kotlin_indent_size, ij_kotlin_continuation_indent_size (ktfmt hat dafür keine eigenen Schalter).",
          "default": "true"
        },
        {
          "key": "heapMb",
          "type": "number",
          "title": "JVM-Heap (MB)",
          "description": "Obergrenze für -Xmx.",
          "default": "512",
          "min": 128,
          "max": 2048
        }
      ]
    }
  },
  "minHostVersion": "3.6.3"
}
