{
  "id": "com.codeforge.plugin.shfmt.formatter",
  "name": "shfmt (Formatierer)",
  "version": "1.0.0",
  "apiVersion": 2,
  "publisher": "codeforge",
  "description": "Formatiert sh, bash, zsh mit shfmt. Fehlende Programme installiert die App nach Bestätigung (sonst: pkg install shfmt).",
  "permissions": [],
  "contributes": {
    "formatters": [
      {
        "id": "shfmt",
        "label": "shfmt",
        "extensions": [
          "sh",
          "bash",
          "zsh"
        ],
        "command": [
          "shfmt",
          "-filename",
          "${file}"
        ],
        "timeoutSeconds": 20
      }
    ],
    "requires": [
      {
        "manager": "pkg",
        "name": "shfmt"
      }
    ]
  }
}
