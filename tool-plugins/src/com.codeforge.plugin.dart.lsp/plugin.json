{
  "id": "com.codeforge.plugin.dart.lsp",
  "name": "Dart Analysis Server (Language Server)",
  "version": "1.0.0",
  "apiVersion": 2,
  "publisher": "codeforge",
  "description": "Bindet Dart Analysis Server ein. Fehlende Programme installiert die App nach Bestätigung (sonst: pkg install dart).",
  "permissions": [],
  "contributes": {
    "lspServers": [
      {
        "id": "dart",
        "label": "Dart Analysis Server",
        "languages": [
          "dart"
        ],
        "command": [
          "dart",
          "language-server"
        ]
      }
    ],
    "requires": [
      {
        "manager": "pkg",
        "name": "dart"
      }
    ]
  }
}
