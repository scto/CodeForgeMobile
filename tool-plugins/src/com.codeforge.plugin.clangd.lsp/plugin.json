{
  "id": "com.codeforge.plugin.clangd.lsp",
  "name": "clangd (C/C++) (Language Server)",
  "version": "1.0.0",
  "apiVersion": 2,
  "publisher": "codeforge",
  "description": "Bindet clangd (C/C++) ein. Fehlende Programme installiert die App nach Bestätigung (sonst: pkg install clang).",
  "permissions": [],
  "contributes": {
    "lspServers": [
      {
        "id": "clangd",
        "label": "clangd (C/C++)",
        "languages": [
          "c",
          "cpp"
        ],
        "command": [
          "clangd"
        ]
      }
    ],
    "requires": [
      {
        "manager": "pkg",
        "name": "clang",
        "check": "clangd"
      }
    ]
  }
}
