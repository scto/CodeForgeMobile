{
  "id": "com.codeforge.plugin.prettier.formatter",
  "name": "Prettier (Formatierer)",
  "version": "1.0.0",
  "apiVersion": 2,
  "publisher": "codeforge",
  "description": "Formatiert js, jsx, mjs, cjs, ts, tsx … mit Prettier. Fehlende Programme installiert die App nach Bestätigung (sonst: npm install -g prettier).",
  "permissions": [],
  "contributes": {
    "formatters": [
      {
        "id": "prettier",
        "label": "Prettier",
        "extensions": [
          "js",
          "jsx",
          "mjs",
          "cjs",
          "ts",
          "tsx",
          "json",
          "css",
          "scss",
          "less",
          "html",
          "md",
          "yaml",
          "yml",
          "vue"
        ],
        "command": [
          "prettier",
          "--stdin-filepath",
          "${file}"
        ],
        "timeoutSeconds": 20
      }
    ],
    "requires": [
      {
        "manager": "pkg",
        "name": "nodejs",
        "check": "node"
      },
      {
        "manager": "npm",
        "name": "prettier"
      }
    ]
  }
}
