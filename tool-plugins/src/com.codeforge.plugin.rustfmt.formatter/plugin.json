{
  "id": "com.codeforge.plugin.rustfmt.formatter",
  "name": "rustfmt (Formatierer)",
  "version": "1.0.0",
  "apiVersion": 2,
  "publisher": "codeforge",
  "description": "Formatiert rs mit rustfmt. Fehlende Programme installiert die App nach Bestätigung (sonst: pkg install rust).",
  "permissions": [],
  "contributes": {
    "formatters": [
      {
        "id": "rustfmt",
        "label": "rustfmt",
        "extensions": [
          "rs"
        ],
        "command": [
          "rustfmt",
          "--edition",
          "2021"
        ],
        "timeoutSeconds": 20
      }
    ],
    "requires": [
      {
        "manager": "pkg",
        "name": "rust",
        "check": "rustfmt"
      }
    ]
  }
}
