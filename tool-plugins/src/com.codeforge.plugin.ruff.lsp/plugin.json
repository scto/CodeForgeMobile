{
  "id": "com.codeforge.plugin.ruff.lsp",
  "name": "Ruff (Python-Linting) (Language Server)",
  "version": "1.0.0",
  "apiVersion": 2,
  "publisher": "codeforge",
  "description": "Bindet Ruff (Python-Linting) ein. Fehlende Programme installiert die App nach Bestätigung (sonst: pkg install ruff).",
  "permissions": [],
  "contributes": {
    "lspServers": [
      {
        "id": "ruff",
        "label": "Ruff (Python-Linting)",
        "languages": [
          "python"
        ],
        "command": [
          "ruff",
          "server"
        ]
      }
    ],
    "requires": [
      {
        "manager": "pkg",
        "name": "ruff"
      }
    ]
  }
}
