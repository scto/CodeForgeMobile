{
  "id": "com.codeforge.plugin.catalog-migrate.tool",
  "name": "Version-Catalog-Migration (Tool)",
  "version": "1.0.0",
  "apiVersion": 2,
  "publisher": "codeforge",
  "description": "Verschiebt hartcodierte Abhängigkeiten aus build.gradle(.kts) in gradle/libs.versions.toml. Erscheint im PT-Menü des Dateibaums. Führt Skripte aus (Berechtigung shell).",
  "permissions": [
    "shell"
  ],
  "contributes": {
    "tools": [
      {
        "id": "migrate",
        "label": "Nach Version Catalog migrieren",
        "description": "Bericht oder Umstellung der Abhängigkeiten",
        "command": [
          "python3",
          "${pluginDir}/tool.py",
          "${projectDir}",
          "${input}"
        ],
        "timeoutSeconds": 120,
        "prompt": {
          "label": "Modus",
          "default": "check",
          "options": [
            {
              "value": "check",
              "label": "Prüfen – nur Bericht, nichts ändern"
            },
            {
              "value": "apply",
              "label": "Anwenden – Änderungen durchführen"
            }
          ]
        },
        "confirm": "Vor dem Umstellen (apply) bitte committen. Mit check gibt es nur einen Bericht."
      }
    ],
    "requires": [
      {
        "manager": "pkg",
        "name": "python",
        "check": "python3"
      }
    ]
  }
}
