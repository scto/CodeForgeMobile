{
  "id": "com.codeforge.plugin.google-java-format.formatter",
  "name": "google-java-format (Formatierer)",
  "version": "1.0.0",
  "apiVersion": 2,
  "publisher": "codeforge",
  "description": "Formatiert Java mit google-java-format 1.36.1 (Google- oder AOSP-Stil). Einstellungsseite für alle Optionen der Kommandozeile.",
  "permissions": [],
  "contributes": {
    "formatters": [
      {
        "id": "google-java-format",
        "label": "google-java-format",
        "extensions": [
          "java"
        ],
        "command": [
          "java",
          "-Xmx${setting:heapMb}m",
          "-XX:+UseSerialGC",
          "-XX:TieredStopAtLevel=1",
          "--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED",
          "--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED",
          "--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED",
          "--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED",
          "--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED",
          "--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED",
          "-jar",
          "${deps}/google-java-format/google-java-format.jar",
          "${setting:style=aosp?--aosp}",
          "${setting:sortImports=false?--skip-sorting-imports}",
          "${setting:removeUnused=false?--skip-removing-unused-imports}",
          "${setting:reflowStrings=false?--skip-reflowing-long-strings}",
          "${setting:formatJavadoc=false?--skip-javadoc-formatting}",
          "${setting:reorderModifiers=false?--skip-reordering-modifiers}",
          "${setting:importsOnly?--fix-imports-only}",
          "--assume-filename",
          "${fileName}",
          "-"
        ],
        "timeoutSeconds": 60
      }
    ],
    "requires": [
      {
        "manager": "pkg",
        "name": "openjdk-17",
        "check": "java"
      },
      {
        "manager": "download",
        "name": "google-java-format",
        "url": "https://repo1.maven.org/maven2/com/google/googlejavaformat/google-java-format/1.36.1/google-java-format-1.36.1-all-deps.jar",
        "sha256": "25b400f003089d23cc5320cdaf1a16cabee19b8aa3434d0ff021b3d9f42154b4",
        "archive": "file",
        "check": "google-java-format.jar"
      }
    ],
    "settings": {
      "title": "google-java-format",
      "items": [
        {
          "key": "style",
          "type": "choice",
          "title": "Stil",
          "default": "google",
          "description": "Google Java Style (2 Leerzeichen) oder AOSP (4 Leerzeichen, Android).",
          "options": [
            {
              "value": "google",
              "label": "Google Java Style"
            },
            {
              "value": "aosp",
              "label": "AOSP (Android)"
            }
          ]
        },
        {
          "key": "sortImports",
          "type": "boolean",
          "title": "Importe sortieren",
          "description": "Aus: --skip-sorting-imports",
          "default": "true"
        },
        {
          "key": "removeUnused",
          "type": "boolean",
          "title": "Unbenutzte Importe entfernen",
          "description": "Aus: --skip-removing-unused-imports",
          "default": "true"
        },
        {
          "key": "reflowStrings",
          "type": "boolean",
          "title": "Lange Strings umbrechen",
          "description": "Aus: --skip-reflowing-long-strings",
          "default": "true"
        },
        {
          "key": "formatJavadoc",
          "type": "boolean",
          "title": "Javadoc formatieren",
          "description": "Aus: --skip-javadoc-formatting",
          "default": "true"
        },
        {
          "key": "reorderModifiers",
          "type": "boolean",
          "title": "Modifier ordnen",
          "description": "JLS-Reihenfolge; aus: --skip-reordering-modifiers",
          "default": "true"
        },
        {
          "key": "importsOnly",
          "type": "boolean",
          "title": "Nur Importe korrigieren",
          "description": "--fix-imports-only: sonst nichts umformatieren",
          "default": "false"
        },
        {
          "key": "heapMb",
          "type": "number",
          "title": "JVM-Heap (MB)",
          "description": "Obergrenze für -Xmx.",
          "default": "256",
          "min": 128,
          "max": 2048
        }
      ]
    }
  },
  "minHostVersion": "3.6.3"
}
