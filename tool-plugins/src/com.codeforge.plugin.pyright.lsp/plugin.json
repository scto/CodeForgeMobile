{
  "id": "com.codeforge.plugin.pyright.lsp",
  "name": "Pyright (Python) (Language Server)",
  "version": "1.0.0",
  "apiVersion": 2,
  "publisher": "codeforge",
  "description": "Bindet Pyright (Python) ein. Fehlende Programme installiert die App nach Bestätigung (sonst: npm install -g pyright).",
  "permissions": [],
  "contributes": {
    "lspServers": [
      {
        "id": "pyright",
        "label": "Pyright (Python)",
        "languages": [
          "python"
        ],
        "command": [
          "pyright-langserver",
          "--stdio"
        ]
      }
    ],
    "requires": [
      {
        "manager": "pkg",
        "name": "nodejs",
        "check": "node"
      },
      {
        "manager": "npm",
        "name": "pyright",
        "check": "pyright-langserver"
      }
    ]
  }
}
