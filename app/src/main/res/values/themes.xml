<?xml version="1.0" encoding="utf-8"?>
<!--
  :app — Fenster-Theme. Die eigentliche UI ist Compose (CodeForgeTheme); dieses Theme liefert nur
  Fensterhintergrund, transparente Systemleisten (Edge-to-Edge) und DayNight-Verhalten.
  Basis-Style wird ab API 28/29 in values-v28/values-v29 erweitert (Display-Cutout, Kontrast-Scrim).
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.CodeForge" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/codeforge_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.CodeForge" parent="Base.Theme.CodeForge" />
</resources>
