<?xml version="1.0" encoding="utf-8"?>
<!--
  :app — Fenster-Theme. Die eigentliche UI ist Compose (CodeForgeTheme); dieses Theme liefert nur
  Fensterhintergrund, transparente Systemleisten (Edge-to-Edge) und DayNight-Verhalten.
  Basis-Style wird ab API 28/29 in values-v28/values-v29 erweitert (Display-Cutout, Kontrast-Scrim).
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.CodeForge" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/codeforge_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!--
      Termux-Attribute (deklariert in :libs:termux-shared/res/values/attrs.xml). Bewusst im Theme.CodeForge und nicht
      im Base-Style, weil values-v28/-v29 den Base-Style ersetzen und die Items sonst verloren gingen.
    -->
    <style name="Theme.CodeForge" parent="Base.Theme.CodeForge">
        <item name="termuxActivityDrawerBackground">?attr/colorSurface</item>
        <item name="extraKeysButtonTextColor">?attr/colorOnSurface</item>
        <item name="extraKeysButtonActiveTextColor">?attr/colorPrimary</item>
        <item name="extraKeysButtonBackgroundColor">@android:color/transparent</item>
        <item name="extraKeysButtonActiveBackgroundColor">?attr/colorSurfaceVariant</item>
    </style>
</resources>
