{
  "Composable": {
    "prefix": "comp",
    "body": [
      "@Composable",
      "fun ${1:Name}(modifier: Modifier = Modifier) {",
      "    $0",
      "}"
    ],
    "description": "Composable-Funktion"
  },
  "Log": {
    "prefix": "logd",
    "body": [
      "Log.d(\"${1:TAG}\", \"${2:Nachricht}\")"
    ],
    "description": "Debug-Log"
  }
}
