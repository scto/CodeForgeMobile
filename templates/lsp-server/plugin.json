{
  "id": "com.example.template.lsp-server",
  "name": "Template: Sprachserver",
  "version": "1.0.0",
  "apiVersion": 2,
  "publisher": "example",
  "description": "Beispiel für die Einbindung eines Language Servers.",
  "permissions": [],
  "contributes": {
    "lspServers": [
      {
        "id": "mylang-ls",
        "label": "MyLang Language Server",
        "languages": [
          "mylang"
        ],
        "command": [
          "${home}/.local/bin/mylang-ls",
          "--stdio"
        ]
      }
    ]
  }
}
